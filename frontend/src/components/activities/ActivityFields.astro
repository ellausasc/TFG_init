---
import TiptapEditor from "../ui/TiptapEditor.astro";

interface Props {
  initialData?: any;
  showTitle?: boolean;
  showSlug?: boolean;
  showSection?: boolean;
  showDates?: boolean;
  showTags?: boolean;
  showStatus?: boolean;
  showType?: boolean;
  showImages?: boolean;
  showIsPrivate?: boolean;
  showCapacity?: boolean;
  showAttachments?: boolean;
  allowedTypes?: { value: string; label: string }[];
}

const ALL_ACTIVITY_TYPES = [
  { value: "GENERAL", label: "General" },
  { value: "TALLER", label: "Taller" },
  { value: "ASSEMBLEA", label: "Assemblea" },
  { value: "JUNTA", label: "Junta" },
];

const {
  initialData,
  showTitle = true,
  showSlug = true,
  showSection = true,
  showDates = true,
  showTags = true,
  showStatus = true,
  showType = true,
  showImages = true,
  showIsPrivate = true,
  showCapacity = true,
  showAttachments = true,
  // Si no s'indica cap restriccio (p.ex. en un context intern), es mostren tots els tipus
  allowedTypes = ALL_ACTIVITY_TYPES,
} = Astro.props;

// Nomes es mostren aqui els adjunts de tipus "document" (actes, convocatories...),
// vegeu CU-12; les imatges (MAIN_IMAGE/SECONDARY_IMAGE) ja tenen el seu propi camp.
const existingAttachments: any[] = initialData?.documents || [];
---


  {showTitle && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Títol de l'activitat</label>
      <input 
        type="text" 
        name="title" 
        value={initialData?.title || ""} 
        required 
        placeholder="Escriu el títol..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  )}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {showSection && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">ID de la Secció</label>
      <input 
        type="number" 
        name="sectionId" 
        value={initialData?.sectionId || ""} 
        required 
        placeholder="Ex: 1" 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  )}

  {showType && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Tipus d'activitat</label>
      {allowedTypes.length > 0 ? (
        <select
          name="type"
          required
          class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition bg-white"
        >
          {allowedTypes.map((option) => (
            <option value={option.value} selected={initialData?.type === option.value}>
              {option.label}
            </option>
          ))}
        </select>
      ) : (
        <p class="text-sm text-red-600">
          No tens cap permís que et permeti crear cap tipus d'activitat.
        </p>
      )}
    </div>
  )}
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  {showDates && (
    <Fragment>
      <div class="mb-6">
        <label class="block text-sm font-semibold text-gray-900 mb-2">Data de l'activitat</label>
        <input 
          type="date" 
          name="activityDate" 
          value={initialData?.activityDate ? new Date(initialData.activityDate).toISOString().split('T')[0] : ""} 
          required 
          class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" 
        />
      </div>
      
      <div class="mb-6">
        <label class="block text-sm font-semibold text-gray-900 mb-2">Inici d'inscripcions</label>
        <input 
          type="date" 
          name="registrationStartDate" 
          value={initialData?.registrationStartDate ? new Date(initialData.registrationStartDate).toISOString().split('T')[0] : ""} 
          class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" 
        />
      </div>

      <div class="mb-6">
        <label class="block text-sm font-semibold text-gray-900 mb-2">Fi d'inscripcions</label>
        <input 
          type="date" 
          name="registrationEndDate" 
          value={initialData?.registrationEndDate ? new Date(initialData.registrationEndDate).toISOString().split('T')[0] : ""} 
          class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" 
        />
      </div>
    </Fragment>
  )}
</div>

{showCapacity && (
  <div class="mb-6">
    <label class="block text-sm font-semibold text-gray-900 mb-2">Aforament (opcional)</label>
    <input 
      type="number" 
      name="capacity" 
      min="1"
      value={initialData?.capacity ?? ""} 
      placeholder="Ex: 30" 
      class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
    />
  </div>
)}

{showImages && (
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Imatge Principal (URL)</label>
      <input 
        type="text" 
        name="mainImage" 
        value={initialData?.mainImage || ""} 
        placeholder="https://..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Imatge Secundària (URL)</label>
      <input 
        type="text" 
        name="secondaryImage" 
        value={initialData?.secondaryImage || ""} 
        placeholder="https://..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  </div>
)}

<div class="mb-6">
  <TiptapEditor 
    name="shortDescription" 
    label="Descripció Curta" 
    id="activityShort" 
    initialValue={initialData?.shortDescription || ""}
    required={true} 
  />
</div>

<div class="mb-6">
  <TiptapEditor 
    name="longDescription" 
    label="Descripció Llarga" 
    id="activityLong" 
    initialValue={initialData?.longDescription || ""}
    required={true} 
  />
</div>

{showStatus && (
  <div class="mb-8 flex items-center justify-center">
    <input 
      type="checkbox" 
      id="status-checkbox" 
      name="status" 
      checked={initialData?.status === "PUBLISHED"} 
      class="w-5 h-5 accent-gray-800" 
    />
    <label for="status-checkbox" class="ml-2 text-sm font-medium text-gray-700">Publicar immediatament</label>
  </div>
)}

{showIsPrivate && (
  <div class="mb-8 flex items-center justify-center">
    <input 
      type="checkbox" 
      id="isPrivate-checkbox" 
      name="isPrivate" 
      checked={initialData?.isPrivate ?? false} 
      class="w-5 h-5 accent-gray-800" 
    />
    <label for="isPrivate-checkbox" class="ml-2 text-sm font-medium text-gray-700">
      Activitat privada (nomes visible amb permis explicit)
    </label>
  </div>
)}

{showAttachments && (
  <div class="mb-8 border-t border-gray-100 pt-6">
    <label class="block text-sm font-semibold text-gray-900 mb-2">
      Documentació adjunta (actes, convocatòries...)
    </label>
    <p class="text-xs text-gray-500 mb-3">
      Si l'activitat es marca com a "privada", els adjunts es desaran al
      magatzem restringit i nomes seran descarregables per usuaris amb
      permís sobre l'apartat de Juntes/Assemblees.
    </p>

    {existingAttachments.length > 0 && (
      <ul id="existing-attachments-list" class="mb-4 divide-y divide-gray-100 border border-gray-200 rounded-md">
        {existingAttachments.map((doc: any) => (
          <li class="flex items-center justify-between px-4 py-2 text-sm">
            <span class="text-gray-700 truncate">{doc.name}</span>
            <label class="flex items-center gap-2 text-red-600 text-xs font-medium cursor-pointer">
              <input type="checkbox" name="removeDocumentIds" value={doc.id} class="accent-red-600" />
              Eliminar
            </label>
          </li>
        ))}
      </ul>
    )}

    <input
      type="file"
      id="new-attachments-input"
      name="newAttachments"
      multiple
      class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 outline-none transition"
    />
    <ul id="pending-attachments-list" class="mt-2 text-xs text-gray-500 space-y-1"></ul>
  </div>
)}

<script>
  // Previsualitzacio simple dels fitxers seleccionats abans de pujar-los
  // (la pujada real es fa al moment d'enviar el formulari, a create/edit.astro)
  const attachmentsInput = document.getElementById('new-attachments-input') as HTMLInputElement | null;
  const pendingList = document.getElementById('pending-attachments-list');

  if (attachmentsInput && pendingList) {
    attachmentsInput.addEventListener('change', () => {
      pendingList.innerHTML = '';
      Array.from(attachmentsInput.files || []).forEach((file) => {
        const li = document.createElement('li');
        li.textContent = `📎 ${file.name}`;
        pendingList.appendChild(li);
      });
    });
  }
</script>