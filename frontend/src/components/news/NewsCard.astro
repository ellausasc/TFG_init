---
import { Picture } from "astro:assets";

export interface Props {
  newsEntry: any;
}

const { newsEntry } = Astro.props;

// Convertimos la fecha, asegurándonos de manejar posibles nulos
const pubDate = newsEntry.publishedAt ? new Date(newsEntry.publishedAt) : new Date();

// Extraiem el nom complet de l'autor (objecte niat)
const authorName = newsEntry.author 
  ? `${newsEntry.author.firstName} ${newsEntry.author.lastName1}` 
  : "Anònim";

// Extraiem el nom de la seccio (objecte niat)
const sectionName = newsEntry.section ? newsEntry.section.name : "General";
---

<li>
  <a href={`/news/${newsEntry.slug}`} class="block group">
    <div class="grid md:grid-cols-1 gap-4 md:gap-2 items-center">
        <Picture
          src={newsEntry.mainImage || "https://images.unsplash.com/photo-1667372393119-3d4c48d07fc9?&fit=crop&w=430&h=240"}
          alt={newsEntry.title}
          width={430}
          height={240}
          sizes="(max-width:800px) 100vw, 800px"
          widths={[200, 400, 800]}
          aspect-ratio="16/9"
          class="w-full rounded-md object-cover group-hover:scale-105 transition-transform duration-300"
        />
        
      <div>
        <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">
          {sectionName}
        </span>

        <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1 group-hover:text-blue-600 transition-colors">
          {newsEntry.title}
        </h2>
        
        <div class="mt-3 text-justify text-gray-600 line-clamp-3" set:html={newsEntry.shortDescription}></div>

        <div class="flex gap-2 mt-3 items-center">
          <span class="text-gray-400">
            {authorName}
          </span>
          <span class="text-gray-400">• </span>
          <time
            class="text-gray-400"
            datetime={pubDate.toISOString()}
          >
            {pubDate.toLocaleDateString("ca-ES")}
          </time>
        </div>
      </div>
    </div>
  </a>
</li>