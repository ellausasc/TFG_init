---
// src/pages/404.astro
// Pagina d'error 404. Diverses vistes ja hi redirigien (per exemple
// sections/[slug].astro i activities/[slug].astro amb Astro.redirect('/404')),
// pero la ruta no existia i el visitant acabava en un error sense sortida.
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import SectionHead from "../components/ui/SectionHead.astro";
---

<Layout
  title="Pàgina no trobada"
  description="El contingut que buscaves no existeix o ja no està disponible.">
  <Container>
    <SectionHead align="center">
      <Fragment slot="title">404 · Pàgina no trobada</Fragment>
      <Fragment slot="desc">
        El contingut que buscaves no existeix, ha canviat d'adreça o ja no està
        disponible públicament.
      </Fragment>
    </SectionHead>

    <div class="text-center mt-10 pb-24">
      <p class="text-gray-500 max-w-xl mx-auto">
        Si hi has arribat des d'un enllaç del portal, avisa'ns a través del
        formulari de contacte i ho revisarem.
      </p>

      <div class="flex flex-wrap gap-4 justify-center mt-8">
        <a
          href="/"
          class="inline-block bg-gray-900 text-white px-6 py-3 rounded-xl hover:bg-gray-800 transition font-medium">
          Tornar a l'inici
        </a>
        <a
          href="/contact"
          class="inline-block bg-white border-2 border-gray-200 px-6 py-3 rounded-xl hover:border-gray-900 hover:bg-gray-50 transition font-medium text-gray-700">
          Contactar amb l'associació
        </a>
      </div>
    </div>
  </Container>
</Layout>
