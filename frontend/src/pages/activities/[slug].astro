---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";

// Assegura't que la ruta sigui correcta segons el teu projecte
import { getActivityBySlug } from "../../services/activitiesService";
import { jwtDecode } from "jwt-decode";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Si el visitant te sessio iniciada, reenviem la galeta perque el backend
// pugui aplicar-li els seus permisos (canViewSections) en lloc de tractar-lo
// sempre com a anonim: en SSR el fetch del servidor no adjunta les galetes
// del navegador automaticament.
const token = Astro.cookies.get("token")?.value;
const headers: Record<string, string> | undefined = token ? { Cookie: `token=${token}` } : undefined;

const activity = await getActivityBySlug(slug, headers);

if (!activity) {
  return Astro.redirect('/404');
}

// Funció auxiliar per formatar les dates de manera més llegible
const formatDate = (dateString: string | undefined) => {
  if (!dateString) return null;
  return new Date(dateString).toLocaleDateString("ca-ES", {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const activityDate = formatDate(activity.activityDate);
const regStart = formatDate(activity.registrationStartDate);
const regEnd = formatDate(activity.registrationEndDate);

const authorName = activity.author ? `${activity.author.firstName} ${activity.author.lastName1}` : 'Autor Desconegut';

// --- Estat de les inscripcions (RF-2.2 / CU-05) ---------------------------
// El backend calcula `enrolledCount`, `availableSpots`, `isFull` i
// `isEnrollmentOpen` a partir de `capacity` i del periode d'inscripcio, de
// manera que aqui nomes cal representar-los.
const hasCapacity = activity.capacity !== null && activity.capacity !== undefined;
const enrolledCount = activity.enrolledCount ?? 0;
const isFull = activity.isFull === true;
const isEnrollmentOpen = activity.isEnrollmentOpen !== false;

// Per saber si l'usuari ja hi esta inscrit comparem el seu id amb la llista de
// participants. Nomes te sentit si hi ha sessio iniciada.
let currentUserId: string | null = null;
if (token) {
  try {
    const payload: any = jwtDecode(token);
    currentUserId = payload.userId ? String(payload.userId) : null;
  } catch (error) {
    console.error("Error decodificant el token:", error);
  }
}

const isAlreadyEnrolled = currentUserId
  ? (activity.participants || []).some((p: any) => String(p.id) === currentUserId)
  : false;

// El boto nomes s'ha d'habilitar si es pot fer l'accio; en cas contrari
// n'expliquem el motiu.
const canEnroll = !isAlreadyEnrolled && !isFull && isEnrollmentOpen;

let enrollDisabledReason = "";
if (!isAlreadyEnrolled) {
  if (isFull) enrollDisabledReason = "Aforament complet";
  else if (!isEnrollmentOpen) enrollDisabledReason = "Inscripcions tancades";
}
---

<Layout title={activity.title}>
  <Container>
    
    <!-- Graella principal: 1 columna a mòbil, 3 columnes a escriptori -->
    <div class="mx-auto max-w-5xl mt-14 grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8">
      
      <!-- 1. CAPÇALERA (Títol). A escriptori ocupa les 2 columnes de la dreta -->
      <div class="md:col-span-2 md:col-start-2 order-1">
        <span class="text-blue-600 uppercase tracking-wider text-sm font-bold bg-blue-50 px-3 py-1 rounded-full">
          {activity.section?.name || 'Secció'}
        </span>
        
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-4 lg:leading-tight text-gray-900">
          {activity.title}
        </h1>
        
        <div class="flex gap-2 mt-4 items-center flex-wrap md:flex-nowrap text-sm text-gray-500 mb-2">
          <span class="font-medium text-gray-700">👤 {authorName}</span>
          <span>•</span>
          <time datetime={new Date(activity.activityDate).toISOString()}>
            📅 {activityDate}
          </time>
        </div>
      </div>

      <!-- 2. BARRA LATERAL (Detalls). A escriptori està a l'esquerra i s'expandeix cap avall -->
      <div class="md:col-span-1 md:col-start-1 md:row-start-1 md:row-span-2 order-2">
        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6 sticky top-8 shadow-sm">
          <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Detalls de l'Activitat</h3>
          
          <ul class="space-y-4 text-sm text-gray-700 mb-6">
            {activity.type && (
              <li>
                <span class="block font-semibold text-gray-900">Tipus:</span>
                {activity.type}
              </li>
            )}
            
            <li>
              <span class="block font-semibold text-gray-900">Data de realització:</span>
              <span class="capitalize">{activityDate}</span>
            </li>
            
            <li>
              <span class="block font-semibold text-gray-900">Places:</span>
              {hasCapacity ? (
                <span class={isFull ? "text-red-600 font-medium" : "text-green-700 font-medium"}>
                  {enrolledCount} de {activity.capacity} ocupades
                  {!isFull && ` · ${activity.availableSpots} lliures`}
                </span>
              ) : (
                <span>{enrolledCount} inscrits · sense límit d'aforament</span>
              )}
            </li>

            {(regStart || regEnd) && (
              <li class="bg-blue-50 p-3 rounded-lg border border-blue-100 mt-4">
                <span class="block font-semibold text-blue-900 mb-1">Període d'inscripció:</span>
                {regStart && <div class="text-blue-800">Inici: {regStart}</div>}
                {regEnd && <div class="text-blue-800 mt-1">Fi: {regEnd}</div>}
              </li>
            )}
          </ul>

          {/* Estat de la inscripcio de l'usuari actual. El boto canvia de
              funcio segons si ja hi esta inscrit, si hi ha places o si el
              periode d'inscripcio es obert. */}
          {isAlreadyEnrolled ? (
            <button
              id="unenroll-btn"
              data-activity-id={activity.id}
              class="w-full bg-white border-2 border-red-200 text-red-600 font-semibold py-3 px-4 rounded-xl hover:bg-red-50 hover:border-red-400 transition-colors flex justify-center items-center gap-2"
            >
              <span>Anul·lar la meva inscripció</span>
            </button>
          ) : canEnroll ? (
            <button
              id="enroll-btn"
              data-activity-id={activity.id}
              class="w-full bg-gray-900 text-white font-semibold py-3 px-4 rounded-xl hover:bg-gray-800 transition-colors shadow-md flex justify-center items-center gap-2"
            >
              <span>Inscriure'm ara</span>
            </button>
          ) : (
            <button
              type="button"
              disabled
              class="w-full bg-gray-200 text-gray-500 font-semibold py-3 px-4 rounded-xl cursor-not-allowed flex justify-center items-center gap-2"
            >
              <span>{enrollDisabledReason}</span>
            </button>
          )}

          {isAlreadyEnrolled && (
            <p class="text-xs text-green-700 text-center mt-3 font-medium">
              Ja estàs inscrit en aquesta activitat.
            </p>
          )}

          <p id="enroll-message" class="text-sm font-medium text-center mt-3 hidden"></p>
        </div>
      </div>

      <!-- 3. CONTINGUT PRINCIPAL (Imatge i text). A escriptori està sota el títol, a la dreta -->
      <div class="md:col-span-2 md:col-start-2 order-3">
        
        {activity.mainImage && (
          <img 
            src={activity.mainImage} 
            alt={`Imatge de l'activitat ${activity.title}`} 
            class="w-full h-auto object-cover rounded-2xl shadow-sm max-h-[500px] mb-8"
          />
        )}

        <div class="prose prose-lg prose-blue max-w-none">
          <div class="text-xl font-medium text-gray-600 mb-8 leading-relaxed">
            <Fragment set:html={activity.shortDescription} />
          </div>
          
          <div class="text-gray-800">
            <Fragment set:html={activity.longDescription} />
          </div>
        </div>

        {activity.documents && activity.documents.length > 0 && (
          <div class="mt-10 border-t border-gray-100 pt-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Documentació adjunta</h3>
            <ul class="space-y-2">
              {activity.documents.map((doc: any) => (
                <li>
                  <a
                    href={`http://localhost:4000/documents/${doc.id}/download`}
                    class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium underline"
                  >
                    📄 {doc.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

    </div>
    
    <!-- Botó de tornar -->
    <div class="text-center mt-16 mb-12">
      <a
        href="/activities"
        class="inline-block bg-white border-2 border-gray-200 px-6 py-3 rounded-xl hover:border-gray-900 hover:bg-gray-50 transition font-medium text-gray-700"
      >
        ← Tornar a Activitats
      </a>
    </div>
  </Container>
</Layout>

<script>

  import { enrollInActivity, unenrollFromActivity } from "../../services/activitiesService";

  const enrollBtn = document.getElementById('enroll-btn') as HTMLButtonElement;
  const enrollMessage = document.getElementById('enroll-message') as HTMLParagraphElement;

  if (enrollBtn) {
    enrollBtn.addEventListener('click', async () => {
      const activityId = enrollBtn.getAttribute('data-activity-id');
      if (!activityId) return;

      // Canviem l'estat visual del boto
      const originalText = enrollBtn.innerHTML;
      enrollBtn.innerHTML = "Processant...";
      enrollBtn.disabled = true;
      enrollBtn.classList.add('opacity-75', 'cursor-not-allowed');

      try {
        // Crida neta al nostre Facade (Servei)
        await enrollInActivity(activityId);

        // Éxito
        enrollMessage.textContent = "Inscripció realitzada amb èxit! 🎉";
        enrollMessage.className = "text-sm font-medium text-center mt-3 text-green-600 block";
        enrollBtn.innerHTML = "Inscrit correctament";
        enrollBtn.classList.replace('bg-gray-900', 'bg-green-600');
        enrollBtn.classList.replace('hover:bg-gray-800', 'hover:bg-green-700');

        // Recarreguem per refrescar el comptador de places i mostrar el boto
        // d'anul·lacio en lloc del d'inscripcio.
        setTimeout(() => window.location.reload(), 1200);

      } catch (error: any) {
        // Fracaso
        enrollMessage.textContent = `Error: ${error.message}`;
        enrollMessage.className = "text-sm font-medium text-center mt-3 text-red-600 block";
        enrollBtn.innerHTML = originalText;
        enrollBtn.disabled = false;
        enrollBtn.classList.remove('opacity-75', 'cursor-not-allowed');

        // Si l'error ve de GraphQL Shield indicant manca d'autenticacio, redirigim
        if (error.message.toLowerCase().includes("autenticat")) {
          setTimeout(() => window.location.href = '/auth/login', 2000);
        }
      }
    });
  }

  // --- Anul·lacio de la propia inscripcio (RF-2.2) ---
  const unenrollBtn = document.getElementById('unenroll-btn') as HTMLButtonElement;

  if (unenrollBtn) {
    unenrollBtn.addEventListener('click', async () => {
      const activityId = unenrollBtn.getAttribute('data-activity-id');
      if (!activityId) return;

      if (!window.confirm("Segur que vols anul·lar la teva inscripció?")) return;

      const originalText = unenrollBtn.innerHTML;
      unenrollBtn.innerHTML = "Processant...";
      unenrollBtn.disabled = true;
      unenrollBtn.classList.add('opacity-75', 'cursor-not-allowed');

      try {
        await unenrollFromActivity(activityId);

        enrollMessage.textContent = "Inscripció anul·lada correctament.";
        enrollMessage.className = "text-sm font-medium text-center mt-3 text-green-600 block";

        // Recarreguem perque torni a aparèixer el boto d'inscripcio i
        // s'actualitzi el nombre de places lliures.
        setTimeout(() => window.location.reload(), 1200);
      } catch (error: any) {
        enrollMessage.textContent = `Error: ${error.message}`;
        enrollMessage.className = "text-sm font-medium text-center mt-3 text-red-600 block";
        unenrollBtn.innerHTML = originalText;
        unenrollBtn.disabled = false;
        unenrollBtn.classList.remove('opacity-75', 'cursor-not-allowed');
      }
    });
  }
</script>