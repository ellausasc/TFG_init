---
// src/pages/me/activities.astro
// RF-2.3 / CU-06: Seguiment de les meves activitats
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import CardActivity from "../../components/activities/ActivityCard.astro";
import { getMyActivities } from "../../services/activitiesService";

export const prerender = false;

if (!Astro.cookies.has("token")) {
  return Astro.redirect("/auth/login");
}

const token = Astro.cookies.get("token")!.value;
const headers = { Cookie: `token=${token}` };

let activities: any[] = [];
try {
  activities = await getMyActivities(headers);
} catch (error) {
  console.error("Error carregant les meves activitats:", error);
}

const now = new Date();
const upcoming = activities.filter((a) => new Date(a.activityDate) >= now);
const past = activities.filter((a) => new Date(a.activityDate) < now);
---

<Layout title="Les meves activitats">
  <Container>
    <SectionHead align="left">
      <Fragment slot="title">Les meves activitats</Fragment>
      <Fragment slot="desc">
        Consulta les activitats i esdeveniments en què estàs inscrit/a.
      </Fragment>
    </SectionHead>

    <main class="mt-10 pb-24">
      <h2 class="text-xl font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2">
        Properes activitats
      </h2>
      {
        upcoming.length > 0 ? (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full mb-12">
            {upcoming.map((activityEntry: any) => (
              <CardActivity activityEntry={activityEntry} />
            ))}
          </ul>
        ) : (
          <p class="text-gray-400 mb-12">No tens cap activitat propera pendent.</p>
        )
      }

      <h2 class="text-xl font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2">
        Activitats passades
      </h2>
      {
        past.length > 0 ? (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full opacity-75">
            {past.map((activityEntry: any) => (
              <CardActivity activityEntry={activityEntry} />
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">Encara no has participat en cap activitat passada.</p>
        )
      }
    </main>
  </Container>
</Layout>
