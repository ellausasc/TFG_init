---
// src/pages/admin/activities/index.astro
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/ui/Container.astro";
import SectionHead from "../../../components/ui/SectionHead.astro";
import CardActivity from "../../../components/activities/ActivityCard.astro";
import FilterActivities from "../../../components/activities/ActivityFilters.astro";
import { getActivities } from "../../../services/activitiesService";

export const prerender = false;

if (!Astro.cookies.has("token")) {
  return Astro.redirect("/auth/login");
}

// En SSR el `fetch` del servidor no adjunta automaticament les galetes del
// navegador, aixi que cal passar-la explicitament perque el backend sapiga
// qui es l'usuari i li apliqui el filtre de visibilitat corresponent.
const token = Astro.cookies.get("token")!.value;
const headers = { Cookie: `token=${token}` };

// 1. Extraiem els parametres de la URL
const page = parseInt(Astro.url.searchParams.get("page") || "1");
const title = Astro.url.searchParams.get("title");
const sectionId = Astro.url.searchParams.get("sectionId");

// 2. Construim el filtre. Aquest llistat d'administracio nomes mostra
// activitats dels tipus GENERAL i TALLER (modul ACTIVITIES): les Assemblees
// i Juntes tenen el seu propi espai d'administracio i no s'han de barrejar
// aqui.
const filter: any = {};
if (title) filter.title = title;
if (sectionId) filter.sectionId = parseInt(sectionId);
filter.types = ["GENERAL", "TALLER"];

// 3. Cridem el servei passant la galeta de sessio. El backend (graphql-shield
// + canViewActivities) segueix aplicant el filtre de visibilitat segons els
// permisos de l'usuari sobre el modul ACTIVITIES.
const { items: activities } = await getActivities({ page, limit: 10, filter }, headers);

// Helper per construir URLs mantenint els filtres actuals
const getPaginationUrl = (newPage: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("page", newPage.toString());
  return `?${params.toString()}`;
};
---

<Layout title="Administrar Activitats">
  <Container>
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
      <SectionHead align="left">
        <Fragment slot="title">Totes les activitats</Fragment>
        <Fragment slot="desc">
          Consulta i gestiona les activitats i tallers que els teus permisos et permeten veure.
        </Fragment>
      </SectionHead>

      <a
        href="/admin/activities/create"
        class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 transition-colors shadow-sm whitespace-nowrap"
      >
        Crear Activitat
      </a>
    </div>

    <FilterActivities action="/admin/activities" />

    <main class="mt-10 pb-24">
      {
        activities.length > 0 ? (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
            {activities.map((activityEntry: any) => (
              <CardActivity
                activityEntry={activityEntry}
                editHref={`/admin/activities/${activityEntry.id}/edit`}
                participantsHref={`/admin/activities/${activityEntry.id}/participants`}
              />
            ))}
          </ul>
        ) : (
          <div class="text-center py-20 rounded-md">
            <h3 class="text-xl font-medium">
              No s'han trobat activitats amb aquests filtres.
            </h3>
            <p class="text-gray-400 mt-2">Prova a canviar els criteris de cerca.</p>
          </div>
        )
      }

      <!-- Paginacio -->
      <div class="mt-12 flex justify-center items-center gap-6">
        <a
          href={getPaginationUrl(page - 1)}
          class={`${page <= 1 ? "hidden" : "px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300 transition"}`}
        >
          Anterior
        </a>

        <span class="font-medium text-gray-700">Pàgina {page}</span>

        <a
          href={getPaginationUrl(page + 1)}
          class={`${activities.length < 10 ? "hidden" : "px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300 transition"}`}
        >
          Següent
        </a>
      </div>
    </main>
  </Container>
</Layout>