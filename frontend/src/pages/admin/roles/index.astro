---
// src/pages/admin/roles/index.astro
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/ui/Container.astro";
import SectionHead from "../../../components/ui/SectionHead.astro";
import { getAllRolesWithPermissions } from "../../../services/rolesService";

export const prerender = false;

if (!Astro.cookies.has("token")) {
  return Astro.redirect("/auth/login");
}

// 1. Obtenim les galetes/token si cal per a la peticio SSR
const token = Astro.cookies.get("token")?.value;
const headers: Record<string, string> | undefined = token ? { Cookie: `token=${token}` } : undefined;

// 2. Obtenim els rols i els seus permisos
const roles = await getAllRolesWithPermissions(headers);

/**
 * Resumeix els permisos d'un rol per mostrar-los en una sola fila de taula.
 * Retorna els mòduls afectats (sense repeticions), quins d'aquests tenen
 * control total (acció '*') i si algun permís està acotat a una secció.
 */
const summarizeRole = (role: any) => {
  const permissions = role.permission || [];

  // Map de mòdul -> té control total?, per no repetir el mateix mòdul quan hi
  // ha diversos permisos sobre ell (crear, editar, llegir...).
  const modules = new Map<string, boolean>();
  let hasSectionScope = false;

  for (const perm of permissions) {
    const moduleName = perm.module?.name;
    if (!moduleName) continue;

    const isFullControl = perm.action?.action?.trim() === "*";
    modules.set(moduleName, (modules.get(moduleName) || false) || isFullControl);

    if (perm.section) hasSectionScope = true;
  }

  return {
    total: permissions.length,
    modules: Array.from(modules.entries()).map(([name, full]) => ({ name, full })),
    hasSectionScope,
  };
};

// Nombre màxim de mòduls que es llisten abans de resumir la resta amb un
// comptador, per evitar que una fila creixi sense control.
const MAX_VISIBLE_MODULES = 4;
---

<Layout title="Administrar Roles i Permisos">
  <Container>
    <!-- Retorn al panell de control -->
    <div class="mb-6">
      <a
        href="/dashboard"
        class="text-indigo-600 hover:text-indigo-800 font-medium text-sm">
        &larr; Tornar al panell de control
      </a>
    </div>

    <div
      class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
      <SectionHead align="left">
        <Fragment slot="title">Roles i Permisos</Fragment>
        <Fragment slot="desc">
          Gestiona l'accés dels usuaris als diferents mòduls del sistema.
        </Fragment>
      </SectionHead>
      <a 
        href="/admin/roles/create"
        class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 transition-colors shadow-sm whitespace-nowrap">
        Crear Nou Rol
      </a>
    </div>

    <main class="pb-24">
      <div class="overflow-x-auto border border-gray-200 rounded-lg">
        <table class="w-full text-sm text-left text-gray-600">
          <thead class="text-xs text-gray-500 uppercase bg-gray-50 border-b">
            <tr>
              <th class="px-6 py-3">Rol</th>
              <th class="px-6 py-3">Mòduls</th>
              <th class="px-6 py-3">Permisos</th>
              <th class="px-6 py-3">Àmbit</th>
              <th class="px-6 py-3 text-right">Accions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            {
              roles.map((role: any) => {
                const summary = summarizeRole(role);
                const visibleModules = summary.modules.slice(0, MAX_VISIBLE_MODULES);
                const hiddenCount = summary.modules.length - visibleModules.length;

                return (
                  <tr class="hover:bg-gray-50 align-top">
                    <td class="px-6 py-3 font-medium text-gray-900">
                      {role.description}
                    </td>

                    <td class="px-6 py-3">
                      {summary.modules.length === 0 ? (
                        <span class="text-gray-400 italic">Sense permisos</span>
                      ) : (
                        <div class="flex flex-wrap gap-1.5">
                          {visibleModules.map((mod) =>
                            mod.full ? (
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-200">
                                ★ {mod.name}
                              </span>
                            ) : (
                              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                                {mod.name}
                              </span>
                            )
                          )}
                          {hiddenCount > 0 && (
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">
                              +{hiddenCount}
                            </span>
                          )}
                        </div>
                      )}
                    </td>

                    <td class="px-6 py-3 whitespace-nowrap">{summary.total}</td>

                    <td class="px-6 py-3 whitespace-nowrap">
                      {summary.hasSectionScope ? (
                        <span class="text-gray-700">Per seccions</span>
                      ) : (
                        <span class="text-gray-400 italic">Global</span>
                      )}
                    </td>

                    <td class="px-6 py-3 text-right whitespace-nowrap">
                      <a
                        href={`/admin/roles/${role.id}/edit`}
                        class="text-indigo-600 hover:text-indigo-800 font-medium text-xs">
                        Editar
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>

        {
          roles.length === 0 && (
            <p class="text-center text-gray-500 italic py-8">
              Encara no hi ha cap rol creat.
            </p>
          )
        }
      </div>

      <p class="text-xs text-gray-400 mt-4">
        El símbol ★ indica control total sobre el mòdul. Consulta el detall
        complet dels permisos a la pantalla d'edició de cada rol.
      </p>
    </main>
  </Container>
</Layout>