---
// src/pages/admin/users/[id]/edit.astro
import Layout from "../../../../layouts/Layout.astro";
import Container from "../../../../components/ui/Container.astro";
import SectionHead from "../../../../components/ui/SectionHead.astro";
import Button from "../../../../components/ui/Button.astro";
import UserFields from "../../../../components/users/UserFields.astro";
import { getUserById } from "../../../../services/usersService";
import { getAllRolesWithPermissions } from "../../../../services/rolesService";

export const prerender = false;

if (!Astro.cookies.has("token")) {
  return Astro.redirect("/auth/login");
}

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/users");

const token = Astro.cookies.get("token")!.value;
const headers = { Cookie: `token=${token}` };

const [user, allRoles] = await Promise.all([
  getUserById(id, headers),
  getAllRolesWithPermissions(headers),
]);

if (!user) return Astro.redirect("/404");

const assignedRoleIds = new Set((user.roles || []).map((r: any) => r.id));
---

<Layout title={`Editar usuari: ${user.firstName} ${user.lastName1}`}>
  <Container>
    <div class="mb-6">
      <a href="/admin/users" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm">
        &larr; Tornar a Usuaris
      </a>
    </div>

    <SectionHead align="left">
      <Fragment slot="title">Editar usuari: {user.firstName} {user.lastName1}</Fragment>
      <Fragment slot="desc">Codi de soci: {user.code}</Fragment>
    </SectionHead>
  </Container>

  <Container class="pb-24 mt-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <div class="lg:col-span-2 bg-white p-8 rounded-xl shadow-sm border border-gray-200">
        <form id="user-form" novalidate>
          <UserFields isProfile={true} initialData={user} />
          <div class="mt-8 text-center">
            <Button type="submit" size="lg">Guardar Canvis</Button>
          </div>
          <div id="user-result" class="font-medium mt-4 hidden text-center"></div>
        </form>
      </div>

      <div class="lg:col-span-1 bg-white p-8 rounded-xl shadow-sm border border-gray-200">
        <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Rols assignats</h3>
        <ul class="space-y-3" id="roles-list">
          {allRoles.map((role: any) => (
            <li class="flex items-center justify-between">
              <span class="text-sm text-gray-700">{role.description}</span>
              <label class="inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  class="role-checkbox accent-indigo-600 w-4 h-4"
                  data-role-id={role.id}
                  checked={assignedRoleIds.has(role.id)}
                />
              </label>
            </li>
          ))}
        </ul>
        {allRoles.length === 0 && (
          <p class="text-sm text-gray-400 italic">No hi ha rols creats encara.</p>
        )}
        <p id="roles-result" class="text-xs font-medium mt-4 hidden"></p>
      </div>
    </div>
  </Container>
</Layout>

<script define:vars={{ userId: id }}>
  window.userId = userId;
</script>

<script>
  import { adminUpdateUser } from "../../../../services/usersService";
  import { assignRoleToUser, removeRoleFromUser } from "../../../../services/rolesService";

  const userId = (window as any).userId as string;
  const form = document.getElementById("user-form") as HTMLFormElement;
  const result = document.getElementById("user-result");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    const input = {
      firstName: formData.get("firstName") as string,
      lastName1: formData.get("lastName1") as string,
      lastName2: (formData.get("lastName2") as string) || undefined,
      phone: (formData.get("phone") as string) || undefined,
      birthDate: (formData.get("birthDate") as string) || undefined,
    };

    try {
      result!.innerText = "Desant canvis...";
      result!.className = "font-medium mt-4 text-blue-600 block text-center";
      await adminUpdateUser(userId, input);
      result!.innerText = "Dades actualitzades correctament!";
      result!.className = "font-medium mt-4 text-green-600 block text-center";
    } catch (err: any) {
      result!.innerText = "Error: " + err.message;
      result!.className = "font-medium mt-4 text-red-600 block text-center";
    }
  });

  // Assignar/revocar rols en marcar/desmarcar cada casella
  document.querySelectorAll(".role-checkbox").forEach((checkbox) => {
    checkbox.addEventListener("change", async (e) => {
      const input = e.target as HTMLInputElement;
      const roleId = input.getAttribute("data-role-id")!;
      const rolesResult = document.getElementById("roles-result");
      input.disabled = true;

      try {
        if (input.checked) {
          await assignRoleToUser(userId, roleId);
        } else {
          await removeRoleFromUser(userId, roleId);
        }
        if (rolesResult) {
          rolesResult.textContent = "Rols actualitzats.";
          rolesResult.className = "text-xs font-medium mt-4 text-green-600 block";
        }
      } catch (err: any) {
        input.checked = !input.checked; // revertim el canvi visual
        if (rolesResult) {
          rolesResult.textContent = "Error: " + err.message;
          rolesResult.className = "text-xs font-medium mt-4 text-red-600 block";
        }
      } finally {
        input.disabled = false;
      }
    });
  });
</script>
