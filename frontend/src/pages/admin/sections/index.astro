---
import Layout from "../../../layouts/Layout.astro";
import SectionHead from "../../../components/ui/SectionHead.astro";
import Container from "../../../components/ui/Container.astro";
import CardSection from "../../../components/sections/SectionCard.astro";
import { getAllSections } from "../../../services/sectionsService";
import { jwtDecode } from "jwt-decode";

export const prerender = false;

// Obtenim les seccions des del servei
const sections = await getAllSections();

// El botó "Crear nova secció" nomes s'ha de mostrar a usuaris amb permis
// sobre el modul SECTIONS (RF-3.1). L'antiga comprovacio via
// `localStorage.getItem("token")` no funcionava mai, ja que la sessio es
// gestiona amb una galeta httpOnly (vegeu memoria, seccio 9.4.1) i mai no
// es guarda cap token a localStorage.
const token = Astro.cookies.get("token")?.value;
let canCreateSections = false;
if (token) {
  try {
    const payload: any = jwtDecode(token);
    const userPerms: string[] = payload.userPermissions || [];
    canCreateSections = userPerms.some((perm) => perm.split(":")[0] === "SECTIONS");
  } catch (error) {
    console.error("Error decodificant el token:", error);
  }
}
---

<Layout title="Seccions">
  <Container>
    <SectionHead align="center">
      <Fragment slot="title">Seccions</Fragment>
      <Fragment slot="desc">
        Explora les diferents àrees temàtiques del nostre portal.
      </Fragment>
    </SectionHead>

    {canCreateSections && (
      <div class="mt-8 flex justify-left">
        <a 
          href="/admin/sections/create" 
          class="bg-gray-800 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition flex items-center gap-2 font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Crear nova secció
        </a>
      </div>
    )}

    <main class="mt-10 pb-24">
      {
        sections.length > 0 ? (
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
            {sections.map((section: any) => (
              <CardSection sectionEntry={section} />
            ))}
          </ul>
        ) : (
          <div class="text-center py-20 rounded-md border border-gray-100">
            <h3 class="text-xl font-medium text-gray-500">
              No s'han trobat seccions disponibles.
            </h3>
          </div>
        )
      }
    </main>
  </Container>
</Layout>