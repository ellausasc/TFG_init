---
import Button from "./ui/button.astro";
import TiptapEditor from "./ui/tiptap_editor.astro";
---

<form id="news-form" class="max-w-2xl mx-auto">
  
  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Títol de la notícia</label>
    <input type="text" placeholder="Escriu el títol..." required class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" name="title" />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, introdueix el títol de la notícia.</div>
  </div>

  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Autor</label>
    <input type="text" placeholder="Nom de l'autor" required class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" name="author" />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, indica l'autor.</div>
  </div>

  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Seccions (separades per comes)</label>
    <input type="text" placeholder="Ex: Esdeveniments, General, Important" required class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" name="sections" />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, afegeix almenys una secció.</div>
  </div>

  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Data de publicació</label>
    <input type="date" required class="w-full px-4 py-3 border-2 text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" name="publication_date" />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, indica la data de publicació.</div>
  </div>

  <TiptapEditor name="short_descr" label="Descripció Curta" required={true} />

  <div class="mb-5 flex items-center">
    <input type="checkbox" id="public-checkbox" name="public" class="w-5 h-5 text-gray-800 border-gray-300 rounded focus:ring-gray-600" />
    <label for="public-checkbox" class="ml-2 text-sm font-medium text-gray-700">Fer pública aquesta notícia immediatament</label>
  </div>

  <div class="flex items-center justify-center mb-5 mt-8">
    <Button type="submit" size="lg">Crear Notícia</Button>
  </div>

  <div id="news-result" class="text-center font-medium mt-3 hidden"></div>
</form>

<style>
  .invalid-feedback, .empty-feedback { display: none; }
  .was-validated :placeholder-shown:invalid ~ .empty-feedback { display: block; }
  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback { display: block; }
  .is-invalid, .was-validated :invalid { border-color: #dc3545; }
</style>

<script>
  function initNewsForm() {
    const form = document.getElementById("news-form") as HTMLFormElement;
    if (!form) return;

    const result = document.getElementById("news-result");
    const GRAPHQL_URL = "http://localhost:4000/graphql";
    const hiddenDescrInput = document.getElementById("short_descr") as HTMLInputElement;

    const handleSubmit = async (e: SubmitEvent) => {
      e.preventDefault();
      form.classList.add("was-validated");

      // Buscamos el contenedor del editor para gestionarlo
      const wrapper = hiddenDescrInput.closest('.tiptap-wrapper') as any;
      const richTextError = wrapper?.querySelector('.rich-text-error');

      // Validación manual de TipTap
      if (!hiddenDescrInput.value && wrapper && richTextError) {
        wrapper.classList.add('editor-error');
        richTextError.classList.remove('hidden');
        richTextError.classList.add('block');
        return;
      }

      // Validación HTML normal
      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector(":invalid") as HTMLElement;
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      const token = localStorage.getItem("token");
      if (!token) {
        window.location.href = "/login";
        return;
      }

      const formData = new FormData(form);
      const rawSections = formData.get("sections") as string;
      const sectionsArray = rawSections.split(',').map(s => s.trim()).filter(s => s.length > 0);

      const graphqlQuery = {
        query: `
          mutation CreateNews($input: CreateNewsInput!) {
            createNews(input: $input) {
              new_id
              title
              slug
            }
          }
        `,
        variables: {
          input: {
            title: formData.get("title"),
            author: formData.get("author"),
            sections: sectionsArray,
            publication_date: formData.get("publication_date"),
            public: formData.get("public") === "on", 
            short_descr: hiddenDescrInput.value
          }
        }
      };

      if(result) {
        result.innerHTML = "Creant notícia...";
        result.classList.remove("hidden", "text-red-500", "text-green-500");
        result.classList.add("text-blue-500", "block");
      }

      try {
        const response = await fetch(GRAPHQL_URL, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${token}` 
          },
          body: JSON.stringify(graphqlQuery),
        });

        const resBody = await response.json();

        if (resBody.errors && resBody.errors.length > 0) {
          throw new Error(resBody.errors[0].message);
        }

        if(result) {
          result.classList.replace("text-blue-500", "text-green-500");
          result.innerHTML = `Notícia creada correctament! (URL: /news/${resBody.data.createNews.slug})`;
        }
        
        form.reset();
        form.classList.remove("was-validated");
        
        // Vaciamos el editor TipTap llamando a la instancia que guardamos en el DOM
        if (wrapper && wrapper._tiptapEditor) {
          wrapper._tiptapEditor.commands.setContent('');
        }
        hiddenDescrInput.value = '';

      } catch (error: any) {
        console.error("Error:", error);
        if(result) {
          result.classList.replace("text-blue-500", "text-red-500");
          result.innerHTML = "Error: " + error.message;
        }
      }
    };

    form.removeEventListener("submit", handleSubmit);
    form.addEventListener("submit", handleSubmit);
  }

  document.addEventListener("DOMContentLoaded", initNewsForm);
  document.addEventListener("astro:after-swap", initNewsForm);
</script>