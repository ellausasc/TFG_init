---
import TiptapEditor from "../ui/tiptap_editor.astro";

interface Props {
  initialData?: any;
  showTitle?: boolean;
  showSlug?: boolean;
  showSection?: boolean;
  showDates?: boolean;
  showTags?: boolean;
  showStatus?: boolean;
  showType?: boolean;
  showImages?: boolean;
}

const { 
  initialData, 
  showTitle = true, 
  showSlug = true,
  showSection = true, 
  showDates = true, 
  showTags = true,
  showStatus = true,
  showType = true,
  showImages = true
} = Astro.props;
---


  {showTitle && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Títol de l'activitat</label>
      <input 
        type="text" 
        name="title" 
        value={initialData?.title || ""} 
        required 
        placeholder="Escriu el títol..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  )}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {showSection && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">ID de la Secció</label>
      <input 
        type="number" 
        name="sectionId" 
        value={initialData?.sectionId || ""} 
        required 
        placeholder="Ex: 1" 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  )}

  {showType && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Tipus d'activitat</label>
      <input 
        type="text" 
        name="type" 
        value={initialData?.type || ""} 
        placeholder="Ex: Taller, Curs, Seminari..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  )}
</div>

{showDates && (
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Data de l'activitat</label>
      <input 
        type="date" 
        name="activityDate" 
        value={initialData?.activityDate ? new Date(initialData.activityDate).toISOString().split('T')[0] : ""} 
        required 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" 
      />
    </div>
    
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Inici d'inscripcions</label>
      <input 
        type="date" 
        name="registrationStartDate" 
        value={initialData?.registrationStartDate ? new Date(initialData.registrationStartDate).toISOString().split('T')[0] : ""} 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" 
      />
    </div>

    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Fi d'inscripcions</label>
      <input 
        type="date" 
        name="registrationEndDate" 
        value={initialData?.registrationEndDate ? new Date(initialData.registrationEndDate).toISOString().split('T')[0] : ""} 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" 
      />
    </div>
  </div>
)}

{showImages && (
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Imatge Principal (URL)</label>
      <input 
        type="text" 
        name="mainImage" 
        value={initialData?.mainImage || ""} 
        placeholder="https://..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Imatge Secundària (URL)</label>
      <input 
        type="text" 
        name="secondaryImage" 
        value={initialData?.secondaryImage || ""} 
        placeholder="https://..." 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
      />
    </div>
  </div>
)}

<div class="mb-6">
  <TiptapEditor 
    name="shortDescription" 
    label="Descripció Curta" 
    id="activityShort" 
    initialValue={initialData?.shortDescription || ""}
    required={true} 
  />
</div>

<div class="mb-6">
  <TiptapEditor 
    name="longDescription" 
    label="Descripció Llarga" 
    id="activityLong" 
    initialValue={initialData?.longDescription || ""}
    required={true} 
  />
</div>

{showStatus && (
  <div class="mb-8 flex items-center justify-center">
    <input 
      type="checkbox" 
      id="status-checkbox" 
      name="status" 
      checked={initialData?.status === true} 
      class="w-5 h-5 accent-gray-800" 
    />
    <label for="status-checkbox" class="ml-2 text-sm font-medium text-gray-700">Activar (Status: True)</label>
  </div>
)}