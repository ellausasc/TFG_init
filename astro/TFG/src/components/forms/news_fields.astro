---
import TiptapEditor from "../ui/tiptap_editor.astro";

interface Props {
  showTitle?: boolean;
  showSection?: boolean;
  showDate?: boolean;
  showTags?: boolean;
  showIsPublic?: boolean;
}

const { 
  showTitle = true, 
  showSection = true, 
  showDate = true, 
  showTags = true ,
  showIsPublic = true
} = Astro.props;
---

{showTitle && (
  <div class="mb-6">
    <label class="block text-sm font-semibold text-gray-900 mb-2">Títol de la notícia</label>
    <input type="text" name="title" required placeholder="Escriu el títol..." class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" />
  </div>
)}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {showSection && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">ID de la Secció</label>
      <input type="number" name="sectionId" required placeholder="Ex: 1" class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" />
    </div>
  )}

  {showDate && (
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-900 mb-2">Data de publicació</label>
      <input type="date" name="publishedAt" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition text-gray-700" />
    </div>
  )}
</div>

{showTags && (
  <div class="mb-6">
    <label class="block text-sm font-semibold text-gray-900 mb-2">IDs de Tags (separats per comes)</label>
    <input type="text" name="tagIds" placeholder="Ex: 1, 2, 3" class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" />
  </div>
)}

<div class="mb-6">
  <TiptapEditor name="shortDescription" label="Descripció Curta" id="newsShort" required={true} />
</div>

<div class="mb-6">
  <TiptapEditor name="longDescription" label="Descripció Llarga" id="newsLong" required={true} />
</div>

{ showIsPublic && (
  <div class="mb-8 flex items-center justify-center">
    <input type="checkbox" id="status-checkbox" name="isPublic" class="w-5 h-5 accent-gray-800" />
    <label for="status-checkbox" class="ml-2 text-sm font-medium text-gray-700">Publicar immediatament</label>
  </div>
)}