---
import Button from "./ui/button.astro";
---

<form id="form" class="max-w-md mx-auto">
  
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nom"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="nom"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix el teu nom.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="text"
      placeholder="Primer Cognom"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="cognom1"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix el teu primer cognom.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="text"
      placeholder="Segon Cognom"
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="cognom2"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix el teu segon cognom.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="text"
      placeholder="DNI / NIE"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="dni"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix el teu DNI o NIE.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="tel"
      placeholder="Telèfon"
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="telefon"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix un número de telèfon vàlid.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="email"
      placeholder="Correu electrònic"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="email"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix el teu correu electrònic.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="date"
      placeholder="Data de naixement"
      required
      class="w-full px-4 py-3 border-2 text-gray-800 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="data_naixement"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, indica la teva data de naixement.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="password"
      placeholder="Contrasenya"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="password"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix una contrasenya.
    </div>
  </div>

  <div class="mb-5">
    <input
      type="password"
      placeholder="Confirmar Contrasenya"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
      name="password_confirm"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Si us plau, introdueix una contrasenya.
    </div>
  </div>

  <div class="flex items-center justify-center mb-5 mt-8">
    <Button type="submit" size="lg">Registrar-se</Button>
  </div>

  <div id="result" class="text-center font-medium mt-3"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }
</style>

<script src = "../scripts/register.js"></script>