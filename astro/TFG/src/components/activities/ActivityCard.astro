---
import { Picture } from "astro:assets";

export interface Props {
  activityEntry: any;
}

const { activityEntry } = Astro.props;

// Adaptación: Usamos activityDate (camelCase)
const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return {
    day: d.getDate(),
    month: d.toLocaleDateString("ca-ES", { month: "long" }),
    weekday: d.toLocaleDateString("ca-ES", { weekday: "long" }),
    year: d.getFullYear(),
  };
};

const dateInfo = formatDate(activityEntry.activityDate);
---

<li class="bg-white rounded-md shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
  <a
    href={`/activity/${activityEntry.slug}`}
    class="flex flex-col sm:flex-row overflow-hidden group h-full"
  >
    <div class="w-full sm:w-1/3 h-48 sm:h-auto overflow-hidden">
      <Picture
        src={activityEntry.mainImage || "https://images.unsplash.com/photo-1667372393119-3d4c48d07fc9?&fit=crop&w=430&h=240"}
        alt={activityEntry.title}
        width={430}
        height={240}
        sizes="(max-width:800px) 100vw, 800px"
        widths={[200, 400, 800]}
        aspect-ratio="16/9"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
    
    <div class="flex flex-col justify-center items-center py-3 px-4 sm:w-28 shrink-0 text-center bg-gray-50 border-r border-gray-100">
      <span class="text-[3rem] font-bold leading-none tracking-tighter text-blue-600">
        {dateInfo.day}
      </span>
      <span class="text-sm font-bold leading-tight capitalize">
        {dateInfo.month}
      </span>
      <span class="text-[10px] uppercase opacity-80 mt-1">
        {dateInfo.weekday}
      </span>
    </div>
    
    <div class="p-4 flex flex-col justify-center flex-1">
      <div class="text-gray-500 text-[10px] mb-1 uppercase font-semibold tracking-wider">
        {dateInfo.year} 
        <span class="text-slate-400 mx-1">•</span> 
        <span class="text-slate-700">ACTIVITAT</span>
      </div>
      <h3 class="text-lg font-bold text-slate-900 leading-tight group-hover:text-blue-600 transition-colors">
        {activityEntry.title}
      </h3>
    </div>
  </a>
</li>