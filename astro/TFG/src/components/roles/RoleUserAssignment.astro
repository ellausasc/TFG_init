---
export interface Props {
  roleId: string;
  assignedUsers: any[];
  allUsers: any[];
}

const { roleId, assignedUsers, allUsers } = Astro.props;

// Filtrem perquè al select només surtin usuaris que ENCARA NO tenen el rol
const unassignedUsers = allUsers.filter(user => 
  !assignedUsers.some(assigned => assigned.id === user.id)
);
---

<div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200" data-role-id={roleId}>
  <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Usuaris amb aquest rol</h3>
  
  <div class="flex gap-4 items-end mb-6 bg-gray-50 p-4 rounded-lg border border-gray-100">
    <div class="flex-1">
      <label for="select-user" class="block text-xs font-semibold text-gray-700 mb-1">Selecciona un usuari per assignar-li el rol</label>
      <select id="select-user" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:border-indigo-500">
        <option value="" disabled selected>Selecciona un usuari...</option>
        {unassignedUsers.map((u: any) => (
          <option value={u.id}>{u.firstName} {u.lastName1} ({u.email})</option>
        ))}
      </select>
    </div>
    <button type="button" id="btn-assign-user" class="bg-indigo-600 text-white font-semibold py-2 px-4 rounded-md hover:bg-indigo-700 transition text-sm">
      Assignar Usuari
    </button>
  </div>
  <p id="user-error" class="hidden text-sm text-red-600 mb-4"></p>

  {assignedUsers.length === 0 ? (
    <p class="text-gray-500 italic text-sm text-center py-4">Cap usuari té aquest rol actualment.</p>
  ) : (
    <div class="overflow-x-auto border border-gray-200 rounded-lg">
      <table class="w-full text-sm text-left text-gray-600">
        <thead class="text-xs text-gray-500 uppercase bg-gray-50 border-b">
          <tr>
            <th class="px-6 py-3">Nom</th>
            <th class="px-6 py-3">Email</th>
            <th class="px-6 py-3 text-right">Accions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {assignedUsers.map((user: any) => (
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-3 font-medium text-gray-900">{user.firstName} {user.lastName1}</td>
              <td class="px-6 py-3">{user.email}</td>
              <td class="px-6 py-3 text-right">
                <button type="button" class="text-red-500 hover:text-red-700 font-medium text-xs btn-remove-user" data-user-id={user.id}>
                  Revocar Rol
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>

<script>
  import { assignRoleToUser, removeRoleFromUser } from "../../services/rolesService";

  const container = document.querySelector('[data-role-id]') as HTMLElement;
  if (container) {
    const roleId = container.getAttribute('data-role-id')!;
    const btnAssign = document.getElementById('btn-assign-user') as HTMLButtonElement;
    const selectUser = document.getElementById('select-user') as HTMLSelectElement;
    const errorMsg = document.getElementById('user-error') as HTMLParagraphElement;

    // Assignar rol
    btnAssign?.addEventListener('click', async () => {
      const userId = selectUser.value;
      if (!userId) return;

      btnAssign.disabled = true;
      btnAssign.textContent = "Assignant...";
      
      try {
        await assignRoleToUser(userId, roleId);
        window.location.reload(); // Recarreguem per veure els canvis a les llistes
      } catch (err: any) {
        errorMsg.textContent = err.message;
        errorMsg.classList.remove('hidden');
        btnAssign.disabled = false;
        btnAssign.textContent = "Assignar Usuari";
      }
    });

    // Revocar rol
    document.querySelectorAll('.btn-remove-user').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const userId = (e.target as HTMLButtonElement).getAttribute('data-user-id')!;
        if (confirm("Segur que vols revocar aquest rol a l'usuari?")) {
          try {
            await removeRoleFromUser(userId, roleId);
            window.location.reload(); // Recarreguem
          } catch (err: any) {
            alert(err.message);
          }
        }
      });
    });
  }
</script>