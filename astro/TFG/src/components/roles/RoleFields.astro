---
// src/components/roles/RoleForm.astro

export interface Props {
  modules: any[];
  actions: any[];
  sections: any[];
  isEdit?: boolean;
  initialData?: {
    description: string;
    permissions: any[]; // Permisos existentes formateados para la tabla
  };
}

const { modules, actions, sections, isEdit = false, initialData } = Astro.props;

// Convertimos los permisos iniciales a JSON para pasarlos al script del cliente
const initialPermissionsJson = initialData?.permissions ? JSON.stringify(initialData.permissions) : "[]";
---

<form id="role-form" class="space-y-8" novalidate data-initial-permissions={initialPermissionsJson}>
  
  <div>
    <label for="description" class="block text-sm font-semibold text-gray-900 mb-2">
      Nom del Rol <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="description"
      name="description"
      value={initialData?.description || ""}
      required
      placeholder="Ex: Editor d'Esports"
      class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-indigo-600 outline-none transition"
    />
  </div>

  <hr class="border-gray-100" />

  <div>
    <h3 class="text-lg font-bold text-gray-900 mb-4">Assignació de Permisos</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end bg-gray-50 p-4 rounded-lg border border-gray-200">
      <div class="md:col-span-1">
        <label class="block text-xs font-semibold text-gray-700 mb-1">Mòdul</label>
        <select id="select-module" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:border-indigo-500">
          <option value="" disabled selected>Selecciona...</option>
          {modules.map((m: any) => <option value={m.id} data-name={m.name}>{m.name}</option>)}
        </select>
      </div>
      
      <div class="md:col-span-1">
        <label class="block text-xs font-semibold text-gray-700 mb-1">Acció</label>
        <select id="select-action" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:border-indigo-500">
          <option value="" disabled selected>Selecciona...</option>
          {actions.map((a: any) => <option value={a.id} data-name={a.description}>{a.description}</option>)}
        </select>
      </div>

      <div class="md:col-span-1">
        <label class="block text-xs font-semibold text-gray-700 mb-1">Secció (Opcional)</label>
        <select id="select-section" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:border-indigo-500">
          <option value="">Global (Totes)</option>
          {sections.map((s: any) => <option value={s.id} data-name={s.name}>{s.name}</option>)}
        </select>
      </div>

      <div class="md:col-span-1">
        <button type="button" id="btn-add-permission" class="w-full bg-indigo-50 text-indigo-700 border border-indigo-200 font-semibold py-2 px-4 rounded-md hover:bg-indigo-100 transition text-sm">
          + Afegir Permís
        </button>
      </div>
    </div>

    <div class="mt-4">
      <table class="w-full text-sm text-left text-gray-600 hidden" id="permissions-table">
        <thead class="text-xs text-gray-500 uppercase bg-gray-50 border-b">
          <tr>
            <th class="px-4 py-2">Mòdul</th>
            <th class="px-4 py-2">Acció</th>
            <th class="px-4 py-2">Secció</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody id="permissions-list" class="divide-y divide-gray-100"></tbody>
      </table>
      <p id="no-permissions-msg" class="text-sm text-gray-500 italic mt-2">Encara no s'ha afegit cap permís a la llista.</p>
    </div>
  </div>

  <div id="form-error" class="hidden bg-red-50 text-red-600 border border-red-200 p-4 rounded-md text-sm font-medium"></div>

  <div class="flex justify-end gap-4 mt-8 pt-4 border-t border-gray-100">
    <a href="/admin/roles" class="px-6 py-3 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition font-medium">
      Cancel·lar
    </a>
    <button type="submit" id="submit-btn" class="px-6 py-3 bg-gray-900 text-white rounded-md hover:bg-gray-800 transition font-medium flex items-center gap-2">
      {isEdit ? "Actualitzar Rol i Permisos" : "Desar Rol i Permisos"}
    </button>
  </div>

</form>

<script>
  // Aquest script s'encarrega només de la lògica visual del formulari.
  const form = document.getElementById("role-form") as HTMLFormElement;
  
  if (form) {
    const errorDiv = document.getElementById("form-error") as HTMLDivElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    
    const modSelect = document.getElementById("select-module") as HTMLSelectElement;
    const actSelect = document.getElementById("select-action") as HTMLSelectElement;
    const secSelect = document.getElementById("select-section") as HTMLSelectElement;
    const btnAdd = document.getElementById("btn-add-permission") as HTMLButtonElement;
    const listEl = document.getElementById("permissions-list") as HTMLTableSectionElement;
    const tableEl = document.getElementById("permissions-table") as HTMLTableElement;
    const noPermMsg = document.getElementById("no-permissions-msg") as HTMLParagraphElement;

    // Carreguem els permisos inicials si estem editant
    const initialDataStr = form.getAttribute("data-initial-permissions");
    let pendingPermissions: any[] = initialDataStr ? JSON.parse(initialDataStr) : [];

    function renderPermissions() {
      if (pendingPermissions.length === 0) {
        tableEl.classList.add('hidden');
        noPermMsg.classList.remove('hidden');
        listEl.innerHTML = "";
        return;
      }

      tableEl.classList.remove('hidden');
      noPermMsg.classList.add('hidden');
      
      listEl.innerHTML = pendingPermissions.map((p, index) => `
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 font-medium">${p.moduleName}</td>
          <td class="px-4 py-2"><span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-xs font-medium border border-blue-200">${p.actionName}</span></td>
          <td class="px-4 py-2 text-gray-600">${p.sectionName}</td>
          <td class="px-4 py-2 text-right">
            <button type="button" class="text-red-500 hover:text-red-700 font-medium text-xs btn-remove" data-index="${index}">Eliminar</button>
          </td>
        </tr>
      `).join("");

      document.querySelectorAll('.btn-remove').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.target as HTMLButtonElement).getAttribute('data-index')!);
          pendingPermissions.splice(idx, 1);
          renderPermissions();
        });
      });
    }

    // Renderitzar només carregar la pàgina (útil per a l'edició)
    renderPermissions();

    btnAdd.addEventListener("click", () => {
      if (!modSelect.value || !actSelect.value) {
        alert("Mòdul i Acció són obligatoris per afegir un permís.");
        return;
      }

      const perm = {
        moduleId: modSelect.value,
        moduleName: modSelect.options[modSelect.selectedIndex].getAttribute('data-name'),
        actionId: actSelect.value,
        actionName: actSelect.options[actSelect.selectedIndex].getAttribute('data-name'),
        sectionId: secSelect.value || null,
        sectionName: secSelect.value ? secSelect.options[secSelect.selectedIndex].getAttribute('data-name') : "Global (Totes)"
      };

      const isDuplicate = pendingPermissions.some(p => p.moduleId === perm.moduleId && p.actionId === perm.actionId && p.sectionId === perm.sectionId);
      if (isDuplicate) {
        alert("Aquest permís ja està a la llista.");
        return;
      }

      pendingPermissions.push(perm);
      renderPermissions();
      
      modSelect.value = "";
      actSelect.value = "";
      secSelect.value = "";
    });

    // Enviar formulari emitint un Custom Event cap a la pàgina pare
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      errorDiv.classList.add("hidden");

      const formData = new FormData(form);
      const description = (formData.get("description") as string).trim();
      
      if (!description) {
        errorDiv.textContent = "El nom del rol és obligatori.";
        errorDiv.classList.remove("hidden");
        return;
      }

      // Canviem l'estat visual
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = "Processant...";
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-75", "cursor-not-allowed");

      // Despatxa l'esdeveniment a la pàgina pare (create.astro o edit.astro) amb els dades
      const customEvent = new CustomEvent('role-form-submit', { 
        detail: { 
          description, 
          permissions: pendingPermissions,
          // Funcions auxiliars perquè el pare controli l'estat del botó o mostri errors
          showError: (msg: string) => {
            errorDiv.textContent = msg;
            errorDiv.classList.remove("hidden");
          },
          resetButton: () => {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
            submitBtn.classList.remove("opacity-75", "cursor-not-allowed");
          }
        } 
      });

      form.dispatchEvent(customEvent);
    });
  }
</script>