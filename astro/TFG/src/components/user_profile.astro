---
// src/components/UserProfile.astro
import Button from "./ui/button.astro";
import UserFields from "./forms/user_fields.astro";
---

<form id="profile-form" class="max-w-md mx-auto" novalidate>
  <h2 class="text-2xl font-bold mb-6 text-gray-800 text-center">El teu perfil</h2>

  <div id="loading" class="text-center text-gray-500 mb-5">Carregant dades...</div>

  <div id="profile-content" class="hidden">
    
    <UserFields isProfile={true} />

    <div class="flex items-center justify-center mb-5 mt-8">
      <Button type="submit" size="lg">Desar Canvis</Button>
    </div>

    <div id="profile-result" class="text-center font-medium mt-3 hidden"></div>
  </div>
</form>

<script>
  import { getMe, updateMe } from "../services/userService";
  import { uploadGenericFile } from "../utils";

  const form = document.getElementById("profile-form") as HTMLFormElement;
  const content = document.getElementById("profile-content");
  const loading = document.getElementById("loading");
  const result = document.getElementById("profile-result");

  async function init() {
    if (!localStorage.getItem("token")) {
      window.location.href = "/login";
      return;
    }
    
    try {
      const user = await getMe();
      
      // Populate fields
      Object.keys(user).forEach(key => {
        // 🚨 Evitem l'error DOMException: el navegador no permet assignar valors a inputs tipus file
        if (key === 'profileImage') return;

        const input = form?.querySelector(`[name="${key}"]`) as HTMLInputElement;
        if (input) {
          if (key === 'birthDate' && user[key as keyof typeof user]) {
            input.value = new Date(Number(user[key as keyof typeof user])).toISOString().split('T')[0];
          } else {
            // Re-activem aquesta línia perquè els valors es mostrin als inputs
            input.value = (user[key as keyof typeof user] as string) || '';
          }
        }
      });

      // Populate Image if it exists
if (user.profileImage) {
        const preview = document.getElementById('profile-picture-preview') as HTMLImageElement;
        const placeholder = document.getElementById('profile-placeholder');
        
        if (preview && placeholder) {
          
          // 1. Destruïm els <source> generats per Astro (si existeixen)
          const pictureWrapper = preview.closest('picture');
          if (pictureWrapper) {
            pictureWrapper.querySelectorAll('source').forEach(source => source.remove());
          }
          
          // 2. CORRECCIÓ CLAU: Llevem el 'hidden' directament a la imatge
          preview.classList.remove('hidden');
          
          // 3. CORRECCIÓ CLAU 2: Esborrem el 'srcset' perquè el navegador no l'ignori
          preview.removeAttribute('srcset');
          
          // 4. Assignem la URL real de MinIO
          preview.src = user.profileImage;
          placeholder.classList.add('hidden');
        }
      }

      if(loading && content) {
        loading.classList.add("hidden");
        content.classList.remove("hidden");
      }
    } catch (err) {
      if(loading) {
        loading.textContent = "Error carregant dades.";
        loading.classList.add("text-red-500");
      }
    }
  }

  if(form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      form.classList.add("was-validated");
      if (!form.checkValidity()) return;

      const formData = new FormData(form);
      
      if(result) {
        result.textContent = "Desant...";
        result.className = "text-center font-medium mt-3 text-blue-500 block";
      }

      try {
        let profileImageUrl = undefined;
        const fileField = formData.get("profileImage") as File;

        // Si l'usuari ha seleccionat una imatge nova, la pugem
        if (fileField && fileField.size > 0) {
          if(result) result.innerHTML = "Actualitzant imatge...";
          profileImageUrl = await uploadGenericFile(fileField);
        }

        const updateData: Record<string, any> = {
          firstName: formData.get("firstName"),
          lastName1: formData.get("lastName1"),
          lastName2: formData.get("lastName2") || undefined,
          phone: formData.get("phone") || undefined,
          birthDate: formData.get("birthDate"),
        };

        if (profileImageUrl) {
          updateData.profileImage = profileImageUrl;
        }

        await updateMe(updateData);
        
        if(result) {
          result.textContent = "Perfil actualitzat correctament!";
          result.className = "text-center font-medium mt-3 text-green-500 block";
          setTimeout(() => result.classList.add("hidden"), 3000);
        }
      } catch (err: any) {
        if(result) {
          result.textContent = err.message || "Error al desar els canvis.";
          result.className = "text-center font-medium mt-3 text-red-500 block";
        }
      }
    });
  }

  // Executar a l'inici
  init();
</script>