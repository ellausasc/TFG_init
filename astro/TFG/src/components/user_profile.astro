---
import Button from "./ui/button.astro";
---

<form id="profile-form" class="max-w-md mx-auto" novalidate>
  <h2 class="text-2xl font-bold mb-6 text-gray-800">El teu perfil</h2>

  <div id="loading" class="text-center text-gray-500 mb-5">Carregant dades...</div>

  <div id="profile-content" class="hidden">
    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
      <input type="text" name="firstName" required class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" />
      <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, introdueix el teu nom.</div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">Primer Cognom</label>
      <input type="text" name="lastName1" required class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" />
      <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, introdueix el teu primer cognom.</div>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">Segon Cognom</label>
      <input type="text" name="lastName2" class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" />
    </div>

    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">DNI / NIE</label>
      <input type="text" name="dni" disabled class="w-full px-4 py-3 border-2 bg-gray-100 text-gray-500 rounded-md cursor-not-allowed" />
    </div>

    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">Telèfon</label>
      <input type="tel" name="phone" class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" />
    </div>

    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">Correu electrònic</label>
      <input type="email" name="email" disabled class="w-full px-4 py-3 border-2 bg-gray-100 text-gray-500 rounded-md cursor-not-allowed" />
    </div>

    <div class="mb-5">
      <label class="block text-sm font-medium text-gray-700 mb-1">Data de naixement</label>
      <input type="date" name="birthDate" required class="w-full px-4 py-3 border-2 text-gray-800 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" />
      <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, indica la teva data de naixement.</div>
    </div>

    <div class="flex items-center justify-center mb-5 mt-8">
      <Button type="submit" size="lg">Desar Canvis</Button>
    </div>

    <div id="result" class="text-center font-medium mt-3"></div>
  </div>
</form>

<style>
  .invalid-feedback, .empty-feedback { display: none; }
  .was-validated :placeholder-shown:invalid ~ .empty-feedback { display: block; }
  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback { display: block; }
  .was-validated :invalid { border-color: #dc3545; }
</style>

<script type="module">
  import { getMe, updateMe } from "/src/services/userService.js";

  const form = document.getElementById("profile-form");
  const content = document.getElementById("profile-content");
  const loading = document.getElementById("loading");
  const result = document.getElementById("result");

  async function init() {
    if (!localStorage.getItem("token")) window.location.href = "/login";
    try {
      const user = await getMe();
      Object.keys(user).forEach(key => {
        const input = form.querySelector(`[name="${key}"]`);
        if (input) {
          if (key === 'birthDate' && user[key]) {
            input.value = new Date(Number(user[key])).toISOString().split('T')[0];
          } else {
            input.value = user[key] || '';
          }
        }
      });
      loading.classList.add("hidden");
      content.classList.remove("hidden");
    } catch (err) {
      loading.textContent = "Error carregant dades.";
      loading.classList.add("text-red-500");
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) return;

    const formData = new FormData(form);
    result.textContent = "Desant...";
    result.className = "text-center font-medium mt-3 text-blue-500";

    try {
      await updateMe({
        firstName: formData.get("firstName"),
        lastName1: formData.get("lastName1"),
        lastName2: formData.get("lastName2"),
        phone: formData.get("phone"),
        birthDate: formData.get("birthDate")
      });
      result.textContent = "Perfil actualitzat!";
      result.className = "text-center font-medium mt-3 text-green-500";
      setTimeout(() => result.classList.add("hidden"), 3000);
    } catch (err) {
      result.textContent = "Error al desar.";
      result.className = "text-center font-medium mt-3 text-red-500";
    }
  });

  init();
</script>