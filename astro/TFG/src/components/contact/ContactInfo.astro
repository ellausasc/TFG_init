---
import Contactform from "./ContactForm.astro";

import { Icon } from "astro-icon/components";

---

<div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">Contacte Associa't</h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">
          Have something to say? We are here to help. Fill up the form or send
          email or call phone.
        </p>
        <div class="mt-5">
          <div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class:list="text-gray-400 w-4 h-4" name="uil:map-marker" />
            <span>17003 Girona</span>
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class:list="text-gray-400 w-4 h-4" name="uil:envelope" /><a
              href="mailto:tfg@udg.edu"
              >tfg@udg.edu</a
            >
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class:list="text-gray-400 w-4 h-4" name="uil:phone" /><a
              href="tel:+34 (637) 666 888">+34 (637) 666 888</a
            >
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>