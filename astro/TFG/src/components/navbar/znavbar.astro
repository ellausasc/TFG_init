---
import Dropdown from "./zdropdown.astro";
import Container from "../container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { getAllSections } from "../../services/sectionsService";

// 1. Carregar seccions dinàmicament
let sections = [];
try {
  const allSections = await getAllSections();
  // Filtrem només les actives
  sections = allSections.filter((s: any) => s.isActive === true);
} catch (error) {
  console.error("Error carregant seccions:", error);
}

// 2. Mapejar les seccions per al menú
const sectionChildren = sections.map((section: any) => ({
  title: section.name,
  path: `/sections/${section.id}` 
}));

const menuitems = [
  { title: "Noticies", path: "/news" },
  { title: "Activitats", path: "/activities" },
  {
    title: "Seccions",
    path: "#",
    children: sectionChildren.length > 0 
      ? sectionChildren 
      : [{ title: "Cap secció disponible", path: "#" }],
  },
  { title: "Qui som?", path: "/#" },
  { title: "Contacte", path: "/contact" },
];

const guestItems = [
  { title: "Iniciar sessió", path: "/login" },
  { title: "Registrar-se", path: "/singup" },
];

const userItems = [
  { title: "El meu perfil", path: "/me" },
  { title: "Les meves activitats", path: "#" },
  { title: "Informació juntes", path: "#" },
  { title: "Administrar noticies", path: "/admin/news/create" },
  { title: "Administrar activitats", path: "/admin/activities/create" },
  { title: "Administrar juntes", path: "#" },
  { title: "Administrar usuaris", path: "#" },
  { title: "Administrar seccions", path: "/admin/sections" },
  { title: "Tancar sessió", path: "#" },
];
---

<Container class="sticky top-0 bg-white z-50">
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg">
          <span class="font-bold text-slate-800">Associa't</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3 items-center">
          {
            menuitems.map((item) => (
              <>
                {item.children && (
                  <Dropdown title={item.title} children={item.children} lastItem={false} />
                )}
                {!item.children && (
                  <li>
                    <a href={item.path} class="flex lg:px-3 py-2 text-gray-600 hover:text-gray-900">
                      {item.title}
                    </a>
                  </li>
                )}
              </>
            ))
          }

          {/* 1. ÀREA PRIVADA (ESTAT: INVITAT) */}
          <div id="guest-menu" class="auth-menu">
            <Dropdown title="Àrea privada" children={guestItems} lastItem={true} />
          </div>

          {/* 2. ÀREA PRIVADA (ESTAT: LOGUEJAT) */}
          <div id="user-menu" class="auth-menu">
            <Dropdown title="Àrea privada" children={userItems} lastItem={true} />
          </div>
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</Container>

<style is:global>
  .auth-menu {
    display: none !important;
  }
  html:not(.is-logged-in) #guest-menu {
    display: block !important;
  }
  html.is-logged-in #user-menu {
    display: block !important;
  }
</style>

<script is:inline>
  function checkAuth() {
    if (typeof localStorage !== "undefined") {
      const token = localStorage.getItem("token");
      if (token) {
        document.documentElement.classList.add("is-logged-in");
      } else {
        document.documentElement.classList.remove("is-logged-in");
      }
    }
  }

  checkAuth();
  document.addEventListener("astro:after-swap", checkAuth);
</script>

<script>
  function setupLogoutListener() {
    document.addEventListener("click", (e) => {
      const target = e.target instanceof HTMLElement ? e.target : null;
      if (target && target.textContent?.trim() === "Tancar sessió") {
        e.preventDefault();
        localStorage.removeItem("token");
        document.documentElement.classList.remove("is-logged-in");
        window.location.href = "/";
      }
    });
  }

  document.addEventListener("DOMContentLoaded", setupLogoutListener);
  document.addEventListener("astro:page-load", setupLogoutListener);
</script>