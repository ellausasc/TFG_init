---
export interface Props {
  sectionEntry: any;
}

const { sectionEntry } = Astro.props;

// Calculamos el número de noticias si existen, si no, 0
const newsCount = sectionEntry.news ? sectionEntry.news.length : 0;
---

<li class="border border-gray-100 rounded-lg p-6 hover:shadow-lg transition-all duration-300 bg-white group flex flex-col justify-between">
  
  <!-- Zona principal clicable (detall secció) -->
  <a href={`/sections/${sectionEntry.id}`} class="block">
    <span class="text-blue-400 uppercase tracking-wider text-xs font-bold">
      Secció
    </span>

    <h2 class="text-2xl font-bold mt-2 text-gray-900 group-hover:text-blue-600 transition-colors">
      {sectionEntry.name}
    </h2>
    
    <p class="text-gray-600 mt-3 line-clamp-3 text-justify">
      {sectionEntry.description || "Aquesta secció no té descripció disponible."}
    </p>
  </a>

  <!-- Footer amb metadades i botó d'edició -->
  <div class="flex justify-between items-center mt-6 pt-4 border-t border-gray-100">
    
    <div class="flex gap-4 items-center text-sm text-gray-500">
      <div class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <span>{newsCount} notícies</span>
      </div>
      
      {sectionEntry.isActive && (
        <span class="px-2 py-1 bg-green-50 text-green-700 rounded text-xs font-medium">
          Activa
        </span>
      )}
    </div>

    <!-- Botó d'edició -->
    <a 
      href={`/admin/sections/edit/${sectionEntry.id}`} 
      class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 px-3 py-1 rounded transition-colors"
      title="Editar secció"
    >
      Editar
    </a>
  </div>
</li>