---
export interface Props {
  name: string;
  label: string;
  required?: boolean;
}

const { name, label, required = false } = Astro.props;
---

<div class="mb-7 tiptap-wrapper" data-editor-name={name}>
  <label class="block text-sm font-medium text-gray-700 mb-1">{label}</label>
  
  <div class="flex flex-wrap gap-2 p-2 bg-gray-100 border-2 border-b-0 border-gray-300 rounded-t-md">
    <button type="button" class="btn-bold px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 font-bold transition-colors" title="Negreta">N</button>
    <button type="button" class="btn-italic px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 italic transition-colors" title="Cursiva">K</button>
    <div class="w-px bg-gray-300 my-1 mx-1"></div>
    <button type="button" class="btn-bullet px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 transition-colors" title="Llista de punts">• Llista</button>
    <button type="button" class="btn-ordered px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 transition-colors" title="Llista numerada">1. Llista</button>
    <div class="w-px bg-gray-300 my-1 mx-1"></div>
    <button type="button" class="btn-blockquote px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 transition-colors" title="Cita">"" Cita</button>
    <button type="button" class="btn-codeblock px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 transition-colors font-mono" title="Codi">&lt;/&gt; Codi</button>
    <div class="w-px bg-gray-300 my-1 mx-1"></div>
    <button type="button" class="btn-undo px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 transition-colors" title="Desfer">↩</button>
    <button type="button" class="btn-redo px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-200 transition-colors" title="Refer">↪</button>
  </div>

  <div class="tiptap-editor bg-white border-2 border-gray-300 rounded-b-md p-4 min-h-[150px] cursor-text"></div>
  
  <input type="hidden" name={name} id={name} required={required} />
  
  <div class="rich-text-error hidden text-red-400 text-sm mt-1">
    Si us plau, omple aquest camp.
  </div>
</div>

<style is:global>
  /* Estilos forzados de TipTap para vencer a Tailwind */
  .ProseMirror { outline: none !important; min-height: 140px; }
  .ProseMirror p { margin-bottom: 0.75em; }
  .ProseMirror ul { list-style-type: disc !important; padding-left: 1.5rem !important; margin-bottom: 0.75em !important; }
  .ProseMirror ol { list-style-type: decimal !important; padding-left: 1.5rem !important; margin-bottom: 0.75em !important; }
  .ProseMirror li { display: list-item !important; }
  .ProseMirror li p { margin-top: 0.25em !important; margin-bottom: 0.25em !important; }
  .ProseMirror blockquote { border-left: 4px solid #cbd5e1 !important; padding-left: 1rem !important; color: #475569 !important; font-style: italic !important; margin-bottom: 0.75em !important; }
  .ProseMirror pre { background-color: #1e293b !important; color: #f8fafc !important; padding: 0.75rem 1rem !important; border-radius: 0.375rem !important; font-family: monospace !important; white-space: pre-wrap !important; margin-bottom: 0.75em !important; }
  .ProseMirror pre code { color: inherit !important; background: none !important; font-size: 0.9em !important; }
  .editor-error .tiptap-editor, .editor-error .bg-gray-100 { border-color: #dc3545 !important; }
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';

  function initEditors() {
    const wrappers = document.querySelectorAll('.tiptap-wrapper');
    
    wrappers.forEach((wrapper: any) => {
      if (wrapper.dataset.initialized) return;

      const name = wrapper.dataset.editorName;
      const editorElement = wrapper.querySelector('.tiptap-editor');
      const hiddenInput = wrapper.querySelector(`input[name="${name}"]`) as HTMLInputElement;
      const errorMsg = wrapper.querySelector('.rich-text-error');

      // Función auxiliar para iluminar/oscurecer los botones
      const updateButtonStates = (editor: Editor) => {
        const toggleBtn = (selector: string, format: string) => {
          const btn = wrapper.querySelector(selector);
          if (btn) {
            const isActive = editor.isActive(format);
            // Si está activo, ponemos fondo gris oscuro. Si no, fondo blanco normal.
            btn.classList.toggle('bg-gray-300', isActive);
            btn.classList.toggle('bg-white', !isActive);
            // Opcional: hacemos el borde un poco más oscuro también
            btn.classList.toggle('border-gray-400', isActive);
            btn.classList.toggle('border-gray-300', !isActive);
          }
        };

        toggleBtn('.btn-bold', 'bold');
        toggleBtn('.btn-italic', 'italic');
        toggleBtn('.btn-bullet', 'bulletList');
        toggleBtn('.btn-ordered', 'orderedList');
        toggleBtn('.btn-blockquote', 'blockquote');
        toggleBtn('.btn-codeblock', 'codeBlock');
      };

      const editor = new Editor({
        element: editorElement as HTMLElement,
        extensions: [StarterKit],
        content: hiddenInput.value || '',
        onUpdate: ({ editor }) => {
          const html = editor.getHTML();
          hiddenInput.value = (html === '<p></p>' || html === '') ? '' : html;
          
          if (hiddenInput.value && errorMsg) {
            wrapper.classList.remove('editor-error');
            errorMsg.classList.add('hidden');
          }
        },
        // NUEVO: onTransaction se ejecuta cada vez que el cursor se mueve o el texto cambia
        onTransaction: ({ editor }) => {
          updateButtonStates(editor);
        }
      });

      // Configurar botones
      wrapper.querySelector('.btn-bold')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().toggleBold().run(); });
      wrapper.querySelector('.btn-italic')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().toggleItalic().run(); });
      wrapper.querySelector('.btn-bullet')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().toggleBulletList().run(); });
      wrapper.querySelector('.btn-ordered')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().toggleOrderedList().run(); });
      wrapper.querySelector('.btn-blockquote')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().toggleBlockquote().run(); });
      wrapper.querySelector('.btn-codeblock')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().toggleCodeBlock().run(); });
      wrapper.querySelector('.btn-undo')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().undo().run(); });
      wrapper.querySelector('.btn-redo')?.addEventListener('click', (e: Event) => { e.preventDefault(); editor.chain().focus().redo().run(); });

      // Sincronizar el estado de los botones al cargar por si el HTML inyectado ya tiene formatos
      updateButtonStates(editor);

      wrapper._tiptapEditor = editor;
      wrapper.dataset.initialized = "true";
    });
  }

  document.addEventListener("DOMContentLoaded", initEditors);
  document.addEventListener("astro:after-swap", initEditors);
</script>