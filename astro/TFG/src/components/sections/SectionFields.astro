---
interface Props {
  initialData?: any;
}

const { initialData } = Astro.props;
---

<div class="mb-6">
  <label class="block text-sm font-semibold text-gray-900 mb-2">Nom de la Secció</label>
  <input 
    type="text" 
    name="name" 
    value={initialData?.name || ""} 
    required 
    placeholder="Ex: Esdeveniments" 
    class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition" 
  />
</div>

<div class="mb-6">
  <label class="block text-sm font-semibold text-gray-900 mb-2">Descripció</label>
  <textarea 
    name="description" 
    rows="3" 
    class="w-full px-4 py-3 border-2 border-gray-200 rounded-md focus:border-gray-800 outline-none transition"
  >{initialData?.description || ""}</textarea>
</div>

<div class="mb-10 flex items-center">
  <input 
    type="checkbox" 
    id="active-checkbox" 
    name="isActive" 
    checked={initialData?.isActive ?? true} 
    class="w-5 h-5 accent-gray-800" 
  />
  <label for="active-checkbox" class="ml-2 text-sm font-medium text-gray-700">Secció activa</label>
</div>