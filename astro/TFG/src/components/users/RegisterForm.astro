---
import Button from "../ui/Button.astro";
import UserFields from "../users/UserFields.astro";
---

<form id="register-form" class="max-w-md mx-auto" novalidate>
  
  <UserFields isProfile={false} />

  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Contrasenya</label>
    <input type="password" placeholder="Contrasenya" required class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" name="password" />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">Si us plau, introdueix una contrasenya.</div>
  </div>

  <div class="mb-5">
    <label class="block text-sm font-medium text-gray-700 mb-1">Confirmar Contrasenya</label>
    <input type="password" placeholder="Confirmar Contrasenya" required class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-none focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100" name="password_confirm" />
  </div>

  <div class="flex items-center justify-center mb-5 mt-8">
    <Button type="submit" size="lg">Registrar-se</Button>
  </div>

  <div id="register-result" class="text-center font-medium mt-3 hidden"></div>
</form>

<script>
  import { registerUser } from "../../services/usersService";
  import type { RegisterUserInput } from "../../types/index";
  import { uploadGenericFile } from "../../utils"; 

  const form = document.getElementById("register-form") as HTMLFormElement;
  const result = document.getElementById("register-result");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      form.classList.add("was-validated");
      
      if (!form.checkValidity()) {
        (form.querySelector(":invalid") as HTMLElement)?.focus();
        return;
      }
      
      const formData = new FormData(form);
      const password = formData.get("password") as string;
      const passwordConfirm = formData.get("password_confirm") as string;

      if (password !== passwordConfirm) {
        if(result) {
          result.innerHTML = "Les contrasenyes no coincideixen!";
          result.className = "text-center font-medium mt-3 text-red-500 block";
        }
        return;
      }

      if(result) {
        result.innerHTML = "Processant registre...";
        result.className = "text-center font-medium mt-3 text-gray-600 block";
      }

      try {
        let profileImageUrl = undefined;
        const fileField = formData.get("profileImage") as File;

        if (fileField && fileField.size > 0) {
          if(result) result.innerHTML = "Pujant imatge de perfil...";
          profileImageUrl = await uploadGenericFile(fileField);
        }

        const mutationInput: RegisterUserInput = {
          firstName: String(formData.get("firstName") || ""),
          lastName1: String(formData.get("lastName1") || ""),
          lastName2: (formData.get("lastName2") ? String(formData.get("lastName2")) : undefined),
          dni: String(formData.get("dni") || ""),
          phone: (formData.get("phone") ? String(formData.get("phone")) : undefined),
          email: String(formData.get("email") || ""),
          password: password,
          birthDate: String(formData.get("birthDate") || ""),
          profileImage: profileImageUrl,
        };

        const data = await registerUser(mutationInput);
        localStorage.setItem("token", data.token);

        if(result) {
          result.className = "text-center font-medium mt-3 text-green-500 block";
          result.innerHTML = `Registre correcte! Benvingut/da ${data.user.firstName}.`;
        }
        
        form.reset();
        form.classList.remove("was-validated");
        
        // Reset image preview
        const preview = document.getElementById('profile-preview');
        const placeholder = document.getElementById('profile-placeholder');
        if(preview && placeholder) {
          preview.classList.add('hidden');
          placeholder.classList.remove('hidden');
        }

      } catch (error: any) {
        console.error("Error en el registre:", error);
        if(result) {
          result.className = "text-center font-medium mt-3 text-red-500 block";
          result.innerHTML = error.message || "Hi ha hagut un error en enviar el formulari!";
        }
      } finally {
        setTimeout(() => { if(result) result.classList.add("hidden"); }, 5000);
      }
    });
  }
</script>