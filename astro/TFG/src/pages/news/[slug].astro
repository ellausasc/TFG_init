---
// src/pages/news/[slug].astro
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import { getNewsBySlug } from "../../services/newsService";

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/404');

const news = await getNewsBySlug(slug);

if (!news) return Astro.redirect('/404');

// Lògica de dates
const rawDate = news.publishedAt;
let dateObj = rawDate ? (typeof rawDate === 'string' && /^\d+$/.test(rawDate) ? new Date(Number(rawDate)) : new Date(rawDate)) : null;
const isValidDate = dateObj && !isNaN(dateObj.getTime());
const displayDate = isValidDate ? dateObj.toLocaleDateString("ca-ES") : "Data no disponible";
const isoDate = isValidDate ? dateObj.toISOString() : "";
const authorFullName = news.author ? `${news.author.firstName} ${news.author.lastName1}` : "Anònim";
---

<Layout title={news.title}>
  <Container>
    
    {/* IMATGE PRINCIPAL - Alineada a la izquierda */}
    {news.mainImage && (
      <img 
        src={news.mainImage} 
        alt={news.title} 
        class="w-full h-80 object-contain rounded-xl mt-8" 
      />
    )}

    {/* Contenidor de text - sense mx-auto perque quedi a l'esquerra */}
    <div class="max-w-3xl mt-14">
      {news.section && (
        <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">
          {news.section.name}
        </span>
      )}
      
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight">
        {news.title}
      </h1>
      
      <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap justify-start">
        <span class="text-gray-400">{authorFullName}</span>
        <span class="text-gray-400">•</span>
        <time class="text-gray-400" datetime={isoDate}>{displayDate}</time>
      </div>
    </div>

    {/* Contenido - Sin mx-auto */}
    <div class="prose prose-lg mt-6 max-w-3xl">
      <div class="text-justify font-semibold text-gray-700" set:html={news.shortDescription}></div>
      <div class="text-justify mt-4 whitespace-pre-line" set:html={news.longDescription}></div>
    </div>
    
    {/* Botón de volver - Centrado (text-center) */}
    <div class="text-center mt-12 mb-8">
      <a
        href="javascript:history.back()"
        class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition inline-block"
        >← Back</a
      >
    </div>
  </Container>
</Layout>