---
// news/[slug].astro (Versión optimizada y segura)
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import { getNewsBySlug } from "../../services/newsService";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const news = await getNewsBySlug(slug);

if (!news) {
  return Astro.redirect('/404');
}

// 1. Manejo seguro de fechas
const displayDate = news.publishedAt 
  ? new Date(news.publishedAt).toLocaleDateString("ca-ES") 
  : "Data no disponible";

// 2. Manejo seguro de autor
const authorFullName = news.author 
  ? `${news.author.firstName} ${news.author.lastName1}` 
  : "Anònim";

// 3. Manejo seguro de fecha para el atributo datetime
const isoDate = news.publishedAt ? new Date(news.publishedAt).toISOString() : "";
---

<Layout title={news.title}>
  <Container>
    <div class="mx-auto max-w-3xl mt-14">
      <!-- Verificamos si existe sección antes de renderizar -->
      {news.section && (
        <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">
          {news.section.name}
        </span>
      )}
      
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight">
        {news.title}
      </h1>
      
      <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap">
        <span class="text-gray-400">
          {authorFullName}
        </span>
        <span class="text-gray-400">•</span>
        <time class="text-gray-400" datetime={isoDate}>
          {displayDate}
        </time>
        
        <!-- Renderizado de tags con comprobación de existencia -->
        {news.tags && news.tags.length > 0 && (
          <>
            <span class="text-gray-400 hidden md:block">•</span>
            <div class="w-full md:w-auto flex flex-wrap gap-3">
              {news.tags.map((tag: any) => (
                <span class="text-sm text-gray-500">#{tag.description}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </div>

    <div class="mx-auto prose prose-lg mt-6 max-w-3xl">
      <!-- shortDescription renderizado como HTML -->
      <div class="text-justify font-semibold text-gray-700" set:html={news.shortDescription}></div>
      
      <!-- longDescription como texto simple (o HTML si tu base de datos guarda formato) -->
      <div class="text-justify mt-4 whitespace-pre-line">
        {news.longDescription}
      </div>
    </div>
    
    <div class="text-center mt-8">
      <a
        href="javascript:history.back()"
        class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition"
        >← Back</a
      >
    </div>
  </Container>
</Layout>