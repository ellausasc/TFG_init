---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import RegisterForm from "../components/register_form.astro";
---

<Layout title="Registre">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Registre</Fragment>
      <Fragment slot="desc"
        >Crea un nou compte per gestionar les teves activitats i
        inscripcions.</Fragment
      >
    </Sectionhead>
  </Container>
  <Container class="pt-16">
    <RegisterForm />
  </Container>
</Layout>
