---
import Layout from "../../layouts/Layout.astro";
import SectionHead from "../../components/sectionhead.astro";
import Container from "../../components/container.astro";
import CardSection from "../../components/ui/card_section.astro";
import { getAllSections } from "../../services/sectionsService";

export const prerender = false;

// Obtenim les seccions des del servei
const sections = await getAllSections();
---

<Layout title="Seccions">
  <Container>
    <SectionHead align="center">
      <Fragment slot="title">Seccions</Fragment>
      <Fragment slot="desc">
        Explora les diferents àrees temàtiques del nostre portal.
      </Fragment>
    </SectionHead>

    <div id="create-btn-container" class="mt-8 flex justify-left hidden">
      <a 
        href="/admin/sections/create" 
        class="bg-gray-800 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition flex items-center gap-2 font-medium"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        Crear nova secció
      </a>
    </div>

    <main class="mt-10 pb-24">
      {
        sections.length > 0 ? (
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
            {sections.map((section: any) => (
              <CardSection sectionEntry={section} />
            ))}
          </ul>
        ) : (
          <div class="text-center py-20 rounded-md border border-gray-100">
            <h3 class="text-xl font-medium text-gray-500">
              No s'han trobat seccions disponibles.
            </h3>
          </div>
        )
      }
    </main>
  </Container>
</Layout>

<script>
  // Mostrar el botó només si l'usuari ha iniciat sessió (té token)
  if (localStorage.getItem("token")) {
    document.getElementById("create-btn-container")?.classList.remove("hidden");
  }
</script>