---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import CreateNewsForm from "../../components/create_news_form.astro";
---

<Layout title="Crear Notícia">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Crear nova notícia</Fragment>
      <Fragment slot="desc">
        Afegeix una nova publicació al portal.
      </Fragment>
    </Sectionhead>
  </Container>
  
  <Container class="pt-16 pb-24">
    <CreateNewsForm />
  </Container>
</Layout>

<script is:inline>
  // Mesura de seguretat: Com que la mutation de crear notícies demana token,
  // si algú intenta entrar a aquesta pàgina sense haver iniciat sessió,
  // l'expulsem directament a la pàgina de login abans de carregar res.
  if (typeof localStorage !== "undefined") {
    if (!localStorage.getItem("token")) {
      window.location.href = "/login";
    }
  }
</script>