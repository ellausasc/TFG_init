---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";

import { getActivityBySlug } from "../../api";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const activity = await getActivityBySlug(slug);

const displayDate = new Date(activity.activity_date).toLocaleDateString("ca-ES");

// Get the entry directly from the prop on render
const { entry } = Astro.props;

---


<Layout title={activity.title}>
  <Container>
    <div class="mx-auto max-w-3xl mt-14">
      <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">
        {activity.sections[0]}
      </span>
      <h1
        class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight">
        {activity.title}
      </h1>
      <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap">
        <span class="text-gray-400">
          {activity.author}
        </span>
        <span class="text-gray-400">•</span>
        <time
          class="text-gray-400"
          datetime={new Date(activity.activity_date).toISOString()}>
          {displayDate}
        </time>
        <span class="text-gray-400 hidden md:block">•</span>
        <div class="w-full md:w-auto flex flex-wrap gap-3">
          {
            activity.sections.map((tag: string) => (
              <span class="text-sm text-gray-500">#{tag}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mx-auto prose prose-lg mt-6 max-w-3xl">
      <p class="text-justify">
        {activity.short_descr}
      </p>
      <p class="text-justify">
        {activity.long_descr}
      </p>
    </div>
    <div class="text-center mt-8">
      <a
        href="/"
        class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition"
        >← Back to Activities</a
      >
    </div>
  </Container>
</Layout>