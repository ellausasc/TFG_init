---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import LoginForm from "../components/login_form.astro";

if (Astro.cookies.has("token")) {
  return Astro.redirect("/me");
}
---

<Layout title="Iniciar sessió">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Iniciar sessió</Fragment>
      <Fragment slot="desc">
        Accedeix al teu compte per gestionar les teves activitats i
        inscripcions.
      </Fragment>
    </Sectionhead>
  </Container>
  <Container class="pt-16">
    <LoginForm />
  </Container>
</Layout>
