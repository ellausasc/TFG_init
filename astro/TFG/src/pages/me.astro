---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import ProfileForm from "../components/user_profile.astro"; // Importamos el nuevo componente
---

<Layout title="El meu Perfil">
  <Container>
    <Sectionhead>
      <Fragment slot="title">El meu Perfil</Fragment>
      <Fragment slot="desc">
        Consulta i gestiona la teva informació personal.
      </Fragment>
    </Sectionhead>
  </Container>
  
  <Container class="pt-16 pb-24">
    <ProfileForm />
  </Container>
</Layout>

<script is:inline>
  // Medida de seguridad: Si alguien intenta acceder a esta página sin haber 
  // iniciado sesión (sin token), lo redirigimos automáticamente al login.
  if (typeof localStorage !== "undefined") {
    if (!localStorage.getItem("token")) {
      window.location.href = "/login";
    }
  }
</script>