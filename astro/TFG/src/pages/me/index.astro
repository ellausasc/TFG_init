---
// src/pages/dashboard.astro
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import DashboardCard from "../../components/me/DashboardCard.astro";
import { jwtDecode } from "jwt-decode";

// Protecció de la ruta
const token = Astro.cookies.get("token")?.value;
if (!token) return Astro.redirect("/auth/login");

let userPerms: string[] = [];

try {
  const payload: any = jwtDecode(token);
  userPerms = payload.userPermissions || [];
} catch (error) {
  return Astro.redirect("/auth/login");
}

// Dades: Accessos Públics
const publicItems = [
  { title: "Notícies", description: "Llegeix les últimes novetats.", path: "/news", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H14" />` },
  { title: "Activitats", description: "Descobreix què fem.", path: "/activities", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />` },
  { title: "Qui som?", description: "Coneix la nostra història.", path: "/#", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />` },
  { title: "Contacte", description: "Parla amb nosaltres.", path: "/contact", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />` }
];

// Dades: Àrea Privada i Administració
const privateItems = [
  { title: "El meu perfil", description: "Dades personals.", path: "/me/profile", reqPerm: null, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />` },
  { title: "Les meves activ.", description: "Inscripcions.", path: "#", reqPerm: null, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />` },
  { title: "Info. Juntes", description: "Documents públics.", path: "#", reqPerm: null, icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />` },
  { title: "Admin. Notícies", description: "Gestió de notícies.", path: "/admin/news/create", reqPerm: "NEWS", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />` },
  { title: "Admin. Activitats", description: "Gestió d'activitats.", path: "/admin/activities/create", reqPerm: "ACTIVITIES", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />` },
  { title: "Admin. Juntes", description: "Gestió d'actes.", path: "#", reqPerm: "ASSEMBLY", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />` },
  { title: "Admin. Usuaris", description: "Gestió de membres.", path: "#", reqPerm: "USERS", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />` },
  { title: "Admin. Seccions", description: "Gestió de seccions.", path: "/admin/sections", reqPerm: "SECTIONS", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />` },
  { title: "Rols i Permisos", description: "Configuració d'accés.", path: "/admin/roles", reqPerm: "ROLES", icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />` }
];

function hasPermission(userPerms: string[], reqPerm: string | null): boolean {
  if (!reqPerm) return true;
  return userPerms.some(perm => {
    const [userModule] = perm.split(":");
    return userModule === reqPerm;
  });
}

const allowedPrivateItems = privateItems.filter(item => hasPermission(userPerms, item.reqPerm));
---

<Layout title="Panell de Control | Associa't">
  <Container>
    <div class="mt-8 mb-12">
      <SectionHead 
        title="Panell de Control" 
        description="Benvingut/da. Accedeix ràpidament a totes les seccions del portal."
      />

            <!-- SECCIÓ 2: PÀGINES PÚBLIQUES -->
      <div class="mt-12">
        <h2 class="text-lg font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2">Accessos Públics</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <!-- 3. Utilitzem el component i li passem el tema "emerald" -->
          {publicItems.map((item) => (
            <DashboardCard 
              title={item.title} 
              description={item.description} 
              path={item.path} 
              icon={item.icon} 
              theme="emerald" 
            />
          ))}
        </div>
      </div>

      <!-- SECCIÓ 1: ÀREA PRIVADA I ADMINISTRACIÓ -->
      <div class="mt-10">
        <h2 class="text-lg font-bold text-gray-800 mb-4 border-b border-gray-100 pb-2">Gestió i Administració</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <!-- 2. Utilitzem el component amb el tema per defecte (índigo) -->
          {allowedPrivateItems.map((item) => (
            <DashboardCard 
              title={item.title} 
              description={item.description} 
              path={item.path} 
              icon={item.icon} 
              theme="indigo"
            />
          ))}
        </div>
      </div>

    </div>
  </Container>
</Layout>