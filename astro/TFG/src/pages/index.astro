---
// index.astro
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import SectionHead from "../components/sectionhead.astro";
import Zcontact from "../components/zcontact.astro";

// Importem els teus nous components!
import CardNews from "../components/ui/card_news.astro";
import CardActivity from "../components/ui/card_activity.astro";

import { fetchGraphQL, HOME_DATA_QUERY } from "../api";

const { getAllNews, getAllActivities } = await fetchGraphQL<any>(HOME_DATA_QUERY);

 const top5NewsEntries = getAllNews
  .filter((n: any) => new Date(n.publication_date) < new Date() && n.public)
//  .sort((a: any, b: any) => new Date(b.publication_date).getTime() - new Date(a.publication_date).getTime())
  .slice(0, 5); 
const publishedActivities = getAllActivities
  .filter((a: any) => new Date(a.publication_date) < new Date())
  .sort((a: any, b: any) => new Date(b.activity_date).getTime() - new Date(a.activity_date).getTime());
---

<Layout title="Home">
  <Container>
    <SectionHead align="center">
      <Fragment slot="title">Welcome to Associa't</Fragment>
      <Fragment slot="desc">A platform to connect people and associations</Fragment>
    </SectionHead>
    
    <main class="mt-16">
      
      <!-- SECCIÓ NOTÍCIES -->
      <div>
        <h2 class="text-4xl font-bold tracking-tight text-left mb-4">
          Últimes notícies
        </h2>
        <ul class="grid md:grid-cols-5 gap-8">
          {top5NewsEntries.map((newsEntry: any) => (
            <CardNews newsEntry={newsEntry} />
          ))}
        </ul>
      </div>

      <!-- SECCIÓ ACTIVITATS -->
      <div class="mt-16">
        <h2 class="text-4xl font-bold tracking-tight text-left mb-8">
          Properes activitats
        </h2>
        <ul class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 mx-auto">
          {publishedActivities.map((activityEntry: any) => (
            <CardActivity activityEntry={activityEntry} />
          ))}
        </ul>
      </div>
      
      <Zcontact />
    </main>
  </Container>
</Layout>