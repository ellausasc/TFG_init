---
// index.astro
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import SectionHead from "../components/sectionhead.astro";
import Zcontact from "../components/zcontact.astro";

import CardNews from "../components/ui/card_news.astro";
import CardActivity from "../components/ui/card_activity.astro";

import { getHomeData } from "../services/homeService";

// Obtenemos los datos del nuevo esquema
const { getNewsFiltered, getAllActivities } = await getHomeData();

const allNews = getNewsFiltered.items;

const publishedActivities = getAllActivities
  .filter((a: any) => a.status && new Date(a.activityDate) > new Date()) // Filtramos para mostrar actividades futuras
  .sort((a: any, b: any) => new Date(a.activityDate).getTime() - new Date(b.activityDate).getTime());
---

<Layout title="Home">
  <Container>
    <SectionHead align="center">
      <Fragment slot="title">Welcome to Associa't</Fragment>
      <Fragment slot="desc">A platform to connect people and associations</Fragment>
    </SectionHead>
    
    <main class="mt-16">
      
      <div>
        <h2 class="text-4xl font-bold tracking-tight text-left mb-4">
          Últimes notícies
        </h2>
        <ul class="grid md:grid-cols-5 gap-8">
          {allNews.map((newsEntry: any) => (
            <CardNews newsEntry={newsEntry} />
          ))}
        </ul>
      </div>

      <div class="mt-16">
        <h2 class="text-4xl font-bold tracking-tight text-left mb-8">
          Properes activitats
        </h2>
        <ul class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 mx-auto">
          {publishedActivities.map((activityEntry: any) => (
            <CardActivity activityEntry={activityEntry} />
          ))}
        </ul>
      </div>
      
      <Zcontact />
    </main>
  </Container>
</Layout>