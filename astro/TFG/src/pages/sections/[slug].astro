---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import CardNews from "../../components/ui/card_news.astro";
import { getSectionById } from "../../services/sectionsService";

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/404');

const section = await getSectionById(slug);

// if (!section) return Astro.redirect('/404');

// Lògica de dates per a la creació de la secció
const rawDate = section.createdAt;
const dateObj = rawDate ? new Date(rawDate) : null;
const displayDate = dateObj ? dateObj.toLocaleDateString("ca-ES") : "Data no disponible";
---

<Layout title={section.name}>
  <Container>
    
    {/* Capçalera de la Secció */}
    <div class="max-w-3xl mt-14">
      <div class="flex items-center gap-4">
        <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">Secció</span>
        {section.isActive ? (
          <span class="px-2 py-1 bg-green-50 text-green-700 rounded text-xs font-bold uppercase">Activa</span>
        ) : (
          <span class="px-2 py-1 bg-red-50 text-red-700 rounded text-xs font-bold uppercase">Inactiva</span>
        )}
      </div>
      
      <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight">
        {section.name}
      </h1>
      
      <p class="text-gray-500 mt-4 text-lg">
        {section.description || "Sense descripció disponible."}
      </p>
      
      <time class="text-gray-400 text-sm mt-4 block">Creat el: {displayDate}</time>
    </div>

    {/* Llistat de notícies associades */}
    <div class="mt-16">
      <h2 class="text-2xl font-bold mb-8">Notícies a {section.name}</h2>
      
      {section.news && section.news.length > 0 ? (
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {section.news.map((newsEntry: any) => (
            <CardNews newsEntry={newsEntry} />
          ))}
        </ul>
      ) : (
        <p class="text-gray-500 italic">No hi ha notícies publicades en aquesta secció encara.</p>
      )}
    </div>
    
    {/* Botón de volver */}
    <div class="text-center mt-12 mb-8">
      <a
        href="javascript:history.back()"
        class="bg-gray-100 px-5 py-3 rounded-md hover:bg-gray-200 transition inline-block"
        >← Tornar</a
      >
    </div>
  </Container>
</Layout>