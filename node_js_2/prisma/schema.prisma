// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int         @id @default(autoincrement())
  code                 String      @unique
  firstName            String
  lastName1            String
  lastName2            String?    
  dni                  String      @unique
  phone                String?
  email                String      @unique
  password             String
  birthDate            DateTime?
  createdAt            DateTime    @default(now()) // data_alta
  deletedAt            DateTime?                   // data_baixa
  profileImage         String?
  
  // Relacions
  roles                Role[]
  createdNews          News[]      @relation("AuthorNews")
  createdActivities    Activity[]  @relation("AuthorActivity")
  enrolledActivities   Activity[]  @relation("Enrollments")
}

model Role {
  id          Int       @id @default(autoincrement())
  description String
  
  // Relacions
  users       User[]
  actions     Action[]
  entities    Entity[]
  sections    Section[]
}

model Entity {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  
  // Relacions
  roles       Role[]
}

model Action {
  id          Int       @id @default(autoincrement())
  description String
  
  // Relacions
  roles       Role[]
}

model Section {
  id               Int         @id @default(autoincrement())
  name             String
  description      String?
  createdAt        DateTime    @default(now())
  publishedAt      DateTime?
  isActive         Boolean     @default(true)

  //
  mainNewsId       Int?        @unique
  mainNews         News?       @relation("MainNews", fields: [mainNewsId], references: [id])
  
  // Relacions
  news             News[]
  activities       Activity[]
  roles            Role[]
}

model Tag {
  id          Int         @id @default(autoincrement())
  description String      @unique
  
  // Relacions
  news        News[]
  activities  Activity[]
}

model News {
  id                  Int       @id @default(autoincrement())
  title               String
  shortDescription    String
  longDescription     String
  createdAt           DateTime  @default(now())
  publishedAt         DateTime?
  status              String?
  type                String?
  mainImage           String?
  secondaryImage      String?
  slug                String    @unique

  // Relacions N:1
  authorId            Int
  author              User      @relation("AuthorNews", fields: [authorId], references: [id])
  sectionId           Int
  section             Section   @relation(fields: [sectionId], references: [id])
  
  // Relació M:N
  tags                Tag[]

  // Relació 1:1
  mainPageOfId        Int?
  mainPageOf          Section?  @relation("MainNews")
}

model Activity {
  id                    Int       @id @default(autoincrement())
  title                 String
  shortDescription      String
  longDescription       String
  createdAt             DateTime  @default(now())
  publishedAt           DateTime?
  status                Boolean   @default(false)
  type                  String?
  activityDate          DateTime
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  mainImage             String?
  secondaryImage        String?
  slug                  String    @unique

  // Relacions N:1
  authorId              Int
  author                User      @relation("AuthorActivity", fields: [authorId], references: [id])
  sectionId             Int
  section               Section   @relation(fields: [sectionId], references: [id])
  
  // Relacions M:N
  tags                  Tag[]
  participants          User[]    @relation("Enrollments")
}

model Documents {
  id        Int      @id @default(autoincrement())
  nombre    String   
  url       String   
  tipo      String
  createdAt DateTime @default(now())
}