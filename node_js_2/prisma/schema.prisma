// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  firstName    String
  lastName1    String
  lastName2    String?
  dni          String    @unique
  phone        String?
  email        String    @unique
  password     String
  birthDate    DateTime?
  createdAt    DateTime  @default(now()) // data_alta
  deletedAt    DateTime? // data_baixa
  profileImage String?

  // Relacions
  roles              Role[]
  createdNews        News[]     @relation("AuthorNews")
  createdActivities  Activity[] @relation("AuthorActivity")
  enrolledActivities Activity[] @relation("Enrollments")
}

model Role {
  id          Int    @id @default(autoincrement())
  description String @unique

  // Relacions
  users      User[]
  permission RolePermission[]
}

model Module {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  // Relacions
  permission RolePermission[]
}

model Action {
  id          Int    @id @default(autoincrement())
  action      String @unique @db.Char(2)
  description String @unique

  // Relacions
  permission RolePermission[]
}

model Section {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  isActive    Boolean   @default(true)

  //
  mainNewsId Int?  @unique
  mainNews   News? @relation("MainNews", fields: [mainNewsId], references: [id])

  // Relacions
  news       News[]
  activities Activity[]
  permission RolePermission[]
}

model RolePermission {
  id Int @id @default(autoincrement())

  // Claves Foráneas
  roleId    Int
  moduleId  Int
  actionId  Int
  sectionId Int? // Opcional: Puede haber permisos globales que no dependan de una sección

  // Relaciones (Con onDelete: Cascade para que si borras un rol, se borren sus permisos)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action  Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Restricción Única: Evita que asignes exactamente el mismo permiso dos veces al mismo rol
  @@unique([roleId, moduleId, actionId, sectionId])
}

model News {
  id               Int       @id @default(autoincrement())
  title            String
  shortDescription String
  longDescription  String
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?
  status           String?
  type             String?
  mainImage        String?
  secondaryImage   String?
  slug             String    @unique

  // Relacions N:1
  authorId  Int
  author    User    @relation("AuthorNews", fields: [authorId], references: [id])
  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])

  // Relació 1:1
  mainPageOfId Int?
  mainPageOf   Section? @relation("MainNews")
}

model Activity {
  id                    Int       @id @default(autoincrement())
  title                 String
  shortDescription      String
  longDescription       String
  createdAt             DateTime  @default(now())
  publishedAt           DateTime?
  status                Boolean   @default(false)
  type                  String?
  activityDate          DateTime
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  mainImage             String?
  secondaryImage        String?
  slug                  String    @unique

  // Relacions N:1
  authorId  Int
  author    User    @relation("AuthorActivity", fields: [authorId], references: [id])
  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id])

  // Relacions M:N
  participants User[] @relation("Enrollments")
}

model Documents {
  id        Int      @id @default(autoincrement())
  nombre    String
  url       String
  tipo      String
  createdAt DateTime @default(now())
}
